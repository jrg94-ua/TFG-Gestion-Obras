@page "/rrhh/horarios"
@attribute [Authorize(Roles = "RecursosHumanos,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject RRHHHorariosService HorariosService
@inject ExportPdfService ExportPdf
@inject ExportExcelService ExportExcel
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Gestion de Horarios - RRHH</PageTitle>

<style>
    .cal-grid {
        display: grid;
        grid-template-columns: 220px repeat(7, 1fr);
        gap: 1px;
        background: #dee2e6;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .cal-hdr {
        background: #2c3e50;
        color: white;
        padding: 14px 8px;
        font-weight: 600;
        text-align: center;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cal-hdr.corner { background: #1a252f; }
    .cal-hdr.hoy { background: #1b5e20; }
    .cal-name {
        background: #f8f9fa;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-right: 3px solid #2c3e50;
        min-height: 76px;
    }
    .cal-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }
    .cal-name-info {
        display: flex;
        flex-direction: column;
    }
    .cal-name-info strong {
        font-size: 0.85rem;
        color: #2c3e50;
    }
    .cal-name-info small {
        font-size: 0.72rem;
        color: #6c757d;
    }
    .cal-cell {
        background: white;
        padding: 5px;
        min-height: 76px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        cursor: pointer;
        transition: background 0.15s;
        position: relative;
    }
    .cal-cell:hover { background: #f0f4ff; }
    .cal-cell.hoy-col { background: #e8f5e9; }
    .cal-cell.hoy-col:hover { background: #c8e6c9; }
    .cal-cell.vacia:hover::after {
        content: '+';
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #c5cad0;
        font-weight: 300;
    }
    .turno-pill {
        border-radius: 8px;
        padding: 4px 8px;
        font-size: 0.72rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        position: relative;
        line-height: 1.3;
    }
    .turno-pill .t-del {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #dc3545;
        color: white;
        border: 2px solid white;
        font-size: 0.6rem;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }
    .turno-pill:hover .t-del { display: flex; }
    .t-man { background: #fff3cd; color: #856404; border-left: 3px solid #ffc107; }
    .t-tar { background: #cfe2ff; color: #084298; border-left: 3px solid #0d6efd; }
    .t-noc { background: #d3d3d9; color: #1e1e2f; border-left: 3px solid #343a40; }
    .t-par { background: #e2d9f3; color: #432874; border-left: 3px solid #6f42c1; }
    .legend-bar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
    }
    .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 4px;
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.82rem;
    }
</style>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary mb-1">Calendario de Horarios - RRHH</h1>
                <p class="text-muted mb-0">Haz clic en una celda vacia para asignar turno</p>
            </div>
            <div class="d-flex gap-2">
                <div class="btn-group">
                    <button class="btn btn-outline-danger" @onclick="ExportarHorariosPdf" title="Exportar a PDF">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                    <button class="btn btn-outline-success" @onclick="ExportarHorariosExcel" title="Exportar a Excel">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                    </button>
                </div>
                <button class="btn btn-primary btn-lg" @onclick="AbrirFormularioNuevo">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Horario
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Proyecto</label>
                        <select class="form-select" @bind="filtroProyectoId" @bind:after="CargarHorarios">
                            <option value="">Todos los proyectos</option>
                            @foreach (var p in proyectos)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Trabajador</label>
                        <select class="form-select" @bind="filtroUsuarioId" @bind:after="CargarHorarios">
                            <option value="">Todos</option>
                            @foreach (var u in trabajadores)
                            {
                                <option value="@u.Id">@u.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="legend-bar ms-auto">
                            <div class="legend-item"><div class="legend-dot" style="background:#ffc107;"></div> Manana</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#0d6efd;"></div> Tarde</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#343a40;"></div> Noche</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#6f42c1;"></div> Partido</div>
                            <span class="badge bg-secondary ms-2">@horarios.Count turnos · @trabConHorario.Count personas</span>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-8">
                        <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@(ProyectoSeleccionado?.Nombre ?? "Selecciona un proyecto")</strong><br />
                                <small>Horas semanales estimadas: @horasEstimadasProyecto.ToString("F1") h</small>
                            </div>
                            <span class="badge bg-primary">@(ProyectoSeleccionado?.Estado.ToString() ?? "Sin proyecto")</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end justify-content-md-end">
                        <button class="btn btn-outline-primary" @onclick="GenerarHorarioAutomatico" disabled="@(ProyectoSeleccionado == null)">
                            <i class="bi bi-magic"></i> Generar horario automatico
                        </button>
                    </div>
                </div>

                @if (ultimoResultadoGeneracion != null)
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="alert @(ultimoResultadoGeneracion.HorasSemanalesDeficit > 0 ? "alert-warning" : "alert-success") mb-0">
                                <div class="fw-semibold mb-1">Resultado de la generacion automatica</div>
                                <div>
                                    Proyecto: @ultimoResultadoGeneracion.HorasSemanalesProyecto.ToString("F1") h/sem |
                                    Capacidad actual: @ultimoResultadoGeneracion.HorasSemanalesCapacidadActual.ToString("F1") h/sem |
                                    Asignadas: @ultimoResultadoGeneracion.HorasSemanalesAsignadas.ToString("F1") h/sem
                                </div>
                                @if (ultimoResultadoGeneracion.HorasSemanalesDeficit > 0)
                                {
                                    <div class="mt-1">
                                        Deficit: @ultimoResultadoGeneracion.HorasSemanalesDeficit.ToString("F1") h/sem |
                                        Trabajadores adicionales estimados: @ultimoResultadoGeneracion.TrabajadoresAdicionalesEstimados
                                    </div>
                                }
                                @if (ultimoResultadoGeneracion.Alertas.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var alerta in ultimoResultadoGeneracion.Alertas)
                                        {
                                            <div><small>- @alerta</small></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!trabConHorario.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div class="display-1 mb-3">Horario</div>
                    <h4 class="text-muted">No hay horarios asignados</h4>
                    <p class="text-muted">Pulsa "Nuevo Horario" para configurar turnos</p>
                </div>
            </div>
        }
        else
        {
            <div class="cal-grid">
                <div class="cal-hdr corner">Trabajador</div>
                @foreach (DiaSemana dia in Enum.GetValues<DiaSemana>())
                {
                    <div class="cal-hdr @(EsHoy(dia) ? "hoy" : "")">
                        @DiaCorto(dia)
                        @if (EsHoy(dia))
                        {
                            <br />
                            <span style="font-weight:400;opacity:0.8;font-size:0.7rem;">HOY</span>
                        }
                    </div>
                }

                @foreach (var t in trabConHorario)
                {
                    var hSem = HorasSemana(t.Id);
                    <div class="cal-name">
                        <div class="cal-avatar">@Iniciales(t.NombreCompleto)</div>
                        <div class="cal-name-info">
                            <strong>@t.NombreCompleto</strong>
                            <small>@hSem.ToString("F0") h / semana</small>
                        </div>
                    </div>

                    @foreach (DiaSemana dia in Enum.GetValues<DiaSemana>())
                    {
                        var turnos = TurnosDia(t.Id, dia);
                        <div class="cal-cell @(EsHoy(dia) ? "hoy-col" : "") @(!turnos.Any() ? "vacia" : "")"
                             @onclick="() => ClickCelda(t.Id, dia)">
                            @foreach (var h in turnos)
                            {
                                <div class="turno-pill @TurnoClass(h.TipoTurno)">
                                    @TurnoIcon(h.TipoTurno) @h.HoraEntrada.ToString("HH:mm")-@h.HoraSalida.ToString("HH:mm")
                                    <button class="t-del" @onclick="() => EliminarHorario(h.Id)" @onclick:stopPropagation="true" title="Eliminar">x</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (horarios.Any(h => h.Proyecto != null))
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white fw-semibold">Resumen por proyecto</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Proyecto</th><th>Trabajadores</th><th>Turnos</th><th>Horas cubiertas/sem</th><th>Horas por cubrir/sem</th><th>Trabajadores faltantes</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var resumen in ObtenerResumenProyectos())
                                {
                                    <tr>
                                        <td><strong>@resumen.NombreProyecto</strong></td>
                                        <td>@resumen.TrabajadoresAsignados</td>
                                        <td>@resumen.TurnosAsignados</td>
                                        <td>@resumen.HorasCubiertas.ToString("F1") h</td>
                                        <td class="@(resumen.HorasPendientes > 0 ? "text-warning fw-semibold" : "text-success fw-semibold")">
                                            @resumen.HorasPendientes.ToString("F1") h
                                        </td>
                                        <td class="@(resumen.TrabajadoresFaltantes > 0 ? "text-warning fw-semibold" : "text-success fw-semibold")">
                                            @resumen.TrabajadoresFaltantes
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (mostrarForm)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content" style="border-radius:16px;border:none;">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold">Asignar turno</h5>
                            <button type="button" class="btn-close" @onclick="CerrarForm"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Trabajador *</label>
                                <select class="form-select" @bind="nuevo.UsuarioId">
                                    <option value="">- Seleccionar -</option>
                                    @foreach (var u in trabajadores)
                                    {
                                        <option value="@u.Id">@u.NombreCompleto</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Proyecto</label>
                                <select class="form-select" @bind="nuevoProyId">
                                    <option value="">- General -</option>
                                    @foreach (var p in proyectos)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Dias *</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (DiaSemana d in Enum.GetValues<DiaSemana>())
                                    {
                                        var sel = diasSel.Contains(d);
                                        <button type="button" class="btn @(sel ? "btn-primary" : "btn-outline-secondary") px-3"
                                                @onclick="() => ToggleDia(d)">@DiaCorto(d)</button>
                                    }
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Entrada *</label>
                                    <input type="text" class="form-control" placeholder="08:00" @bind="heStr" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Salida *</label>
                                    <input type="text" class="form-control" placeholder="14:00" @bind="hsStr" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Turno</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (TipoTurno t in Enum.GetValues<TipoTurno>())
                                    {
                                        <button type="button" class="btn @(nuevo.TipoTurno == t ? "btn-dark" : "btn-outline-secondary")"
                                                @onclick="() => nuevo.TipoTurno = t">@TurnoIcon(t) @t</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button class="btn btn-light" @onclick="CerrarForm">Cancelar</button>
                            <button class="btn btn-primary px-4" @onclick="Guardar" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Asignar @(diasSel.Count > 1 ? $"({diasSel.Count} dias)" : "")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(msg))
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1050;">
                <div class="toast show align-items-center text-bg-@(msgErr ? "danger" : "success") border-0" role="alert" style="border-radius:12px;">
                    <div class="d-flex">
                        <div class="toast-body">@msg</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => msg = null"></button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool cargando = true;
    private bool mostrarForm;
    private bool guardando;
    private bool msgErr;
    private string? msg;

    private List<Proyecto> proyectos = new();
    private List<UsuarioObra> trabajadores = new();
    private List<HorarioAsignado> horarios = new();
    private List<UsuarioObra> trabConHorario = new();
    private Dictionary<int, decimal> horasEstimadasPorProyecto = new();
    private Dictionary<string, double> capacidadSemanalPorUsuario = new();
    private double capacidadMediaOperativaDisponible = RRHHHorariosService.MaxHorasSemanalesPorJornada;

    private string filtroProyectoId = string.Empty;
    private string filtroUsuarioId = string.Empty;
    private decimal horasEstimadasProyecto;
    private GeneracionHorariosResultado? ultimoResultadoGeneracion;

    private HorarioAsignado nuevo = new();
    private string? nuevoProyId;
    private string heStr = "08:00";
    private string hsStr = "14:00";
    private HashSet<DiaSemana> diasSel =
    [
        DiaSemana.Lunes,
        DiaSemana.Martes,
        DiaSemana.Miercoles,
        DiaSemana.Jueves,
        DiaSemana.Viernes
    ];

    private Proyecto? ProyectoSeleccionado => int.TryParse(filtroProyectoId, out var pid)
        ? proyectos.FirstOrDefault(p => p.Id == pid)
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await CargarHorarios();
        cargando = false;
        StateHasChanged();
    }

    private async Task CargarHorarios()
    {
        var contexto = await HorariosService.ObtenerContextoAsync(filtroProyectoId, filtroUsuarioId);
        proyectos = contexto.Proyectos;
        trabajadores = contexto.Trabajadores;
        horarios = contexto.Horarios;
        trabConHorario = contexto.TrabajadoresConHorario;
        horasEstimadasPorProyecto = contexto.HorasEstimadasPorProyecto;
        capacidadSemanalPorUsuario = contexto.CapacidadSemanalPorUsuario;
        capacidadMediaOperativaDisponible = contexto.CapacidadMediaOperativaDisponible;
        horasEstimadasProyecto = contexto.HorasEstimadasProyecto;
    }

    private async Task GenerarHorarioAutomatico()
    {
        if (ProyectoSeleccionado == null)
        {
            Msg("Selecciona primero un proyecto para generar el horario automatico.", true);
            return;
        }

        guardando = true;
        try
        {
            var resultado = await HorariosService.GenerarHorarioAutomaticoAsync(ProyectoSeleccionado.Id);
            ultimoResultadoGeneracion = resultado;
            Msg(resultado.ObtenerMensajeResumen(), resultado.Alertas.Any());
            await CargarHorarios();
        }
        catch (Exception ex)
        {
            Msg($"Error al generar horarios: {ex.Message}", true);
        }
        finally
        {
            guardando = false;
        }
    }

    private IEnumerable<RRHHResumenProyectoHorario> ObtenerResumenProyectos()
    {
        return HorariosService.CalcularResumenProyectos(
            horarios,
            horasEstimadasPorProyecto,
            capacidadSemanalPorUsuario,
            capacidadMediaOperativaDisponible);
    }

    private List<HorarioAsignado> TurnosDia(string uid, DiaSemana dia) =>
        horarios.Where(h => h.UsuarioId == uid && h.DiaSemana == dia).ToList();

    private double HorasSemana(string uid) =>
        horarios.Where(h => h.UsuarioId == uid).Sum(h => h.HorasPrevistas);

    private bool EsHoy(DiaSemana dia) => dia == (DateTime.Now.DayOfWeek switch
    {
        DayOfWeek.Monday => DiaSemana.Lunes,
        DayOfWeek.Tuesday => DiaSemana.Martes,
        DayOfWeek.Wednesday => DiaSemana.Miercoles,
        DayOfWeek.Thursday => DiaSemana.Jueves,
        DayOfWeek.Friday => DiaSemana.Viernes,
        DayOfWeek.Saturday => DiaSemana.Sabado,
        DayOfWeek.Sunday => DiaSemana.Domingo,
        _ => DiaSemana.Lunes
    });

    private static string DiaCorto(DiaSemana dia) => dia switch
    {
        DiaSemana.Lunes => "LUN",
        DiaSemana.Martes => "MAR",
        DiaSemana.Miercoles => "MIE",
        DiaSemana.Jueves => "JUE",
        DiaSemana.Viernes => "VIE",
        DiaSemana.Sabado => "SAB",
        DiaSemana.Domingo => "DOM",
        _ => dia.ToString()
    };

    private static string TurnoClass(TipoTurno turno) => turno switch
    {
        (TipoTurno)0 => "t-man",
        TipoTurno.Tarde => "t-tar",
        TipoTurno.Noche => "t-noc",
        TipoTurno.Partido => "t-par",
        _ => string.Empty
    };

    private static string TurnoIcon(TipoTurno turno) => turno switch
    {
        (TipoTurno)0 => "M",
        TipoTurno.Tarde => "T",
        TipoTurno.Noche => "N",
        TipoTurno.Partido => "P",
        _ => string.Empty
    };

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2
            ? $"{partes[0][0]}{partes[1][0]}"
            : (partes.Length > 0 ? partes[0][0].ToString() : "?");
    }

    private void ClickCelda(string uid, DiaSemana dia)
    {
        if (TurnosDia(uid, dia).Any())
        {
            return;
        }

        nuevo = new HorarioAsignado
        {
            UsuarioId = uid,
            TipoTurno = (TipoTurno)0,
            Activo = true,
            VigenteDesde = DateOnly.FromDateTime(DateTime.Today)
        };
        diasSel = [dia];
        nuevoProyId = null;
        heStr = "08:00";
        hsStr = "14:00";
        mostrarForm = true;
    }

    private void ToggleDia(DiaSemana dia)
    {
        if (!diasSel.Add(dia))
        {
            diasSel.Remove(dia);
        }
    }

    private void AbrirFormularioNuevo()
    {
        nuevo = new HorarioAsignado
        {
            TipoTurno = (TipoTurno)0,
            Activo = true,
            VigenteDesde = DateOnly.FromDateTime(DateTime.Today)
        };
        diasSel =
        [
            DiaSemana.Lunes,
            DiaSemana.Martes,
            DiaSemana.Miercoles,
            DiaSemana.Jueves,
            DiaSemana.Viernes
        ];
        nuevoProyId = null;
        heStr = "08:00";
        hsStr = "14:00";
        mostrarForm = true;
    }

    private void CerrarForm() => mostrarForm = false;

    private async Task Guardar()
    {
        guardando = true;
        try
        {
            var resultado = await HorariosService.GuardarHorarioAsync(
                nuevo,
                nuevoProyId,
                diasSel.ToList(),
                heStr,
                hsStr);

            Msg(resultado.Mensaje, resultado.EsError);
            if (resultado.Correcto)
            {
                mostrarForm = false;
                await CargarHorarios();
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarHorario(int id)
    {
        var resultado = await HorariosService.EliminarHorarioAsync(id);
        Msg(resultado.Mensaje, resultado.EsError);
        if (resultado.Correcto)
        {
            await CargarHorarios();
        }
    }

    private void Msg(string mensaje, bool error)
    {
        msg = mensaje;
        msgErr = error;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            msg = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ExportarHorariosPdf()
    {
        var datos = horarios.OrderBy(h => h.Usuario?.NombreCompleto).ThenBy(h => h.DiaSemana).ToList();
        var bytes = ExportPdf.GenerarInformeHorarios(datos, "Horarios Asignados");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Horarios_{DateTime.Now:yyyyMMdd}.pdf", "application/pdf", base64);
    }

    private async Task ExportarHorariosExcel()
    {
        var datos = horarios.OrderBy(h => h.Usuario?.NombreCompleto).ThenBy(h => h.DiaSemana).ToList();
        var bytes = ExportExcel.GenerarExcelHorarios(datos);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Horarios_{DateTime.Now:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }

}
