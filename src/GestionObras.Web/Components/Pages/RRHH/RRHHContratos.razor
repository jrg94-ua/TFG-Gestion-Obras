@page "/rrhh/contratos"
@attribute [Authorize(Roles = "RecursosHumanos,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Core.Contracts.JefeObra
@using GestionObras.Core.Contracts.RRHH
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject RRHHApiClient RRHHApiClient
@inject ExportPdfService ExportPdf
@inject ExportExcelService ExportExcel
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Gestion de Contratos - RRHH</PageTitle>

@if (cargando)
{
    <div class="text-center p-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div><h1 class="text-primary">Gestion de Contratos - RRHH</h1><p class="text-muted mb-0">Administracion de contratos laborales de toda la plantilla</p></div>
            <div class="d-flex gap-2">
                <div class="btn-group">
                    <button class="btn btn-outline-danger" @onclick="ExportarContratosPdf"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                    <button class="btn btn-outline-success" @onclick="ExportarContratosExcel"><i class="bi bi-file-earmark-spreadsheet"></i> Excel</button>
                </div>
                <button class="btn btn-primary" @onclick="AbrirFormularioNuevo"><i class="bi bi-plus-circle"></i> Nuevo Contrato</button>
            </div>
        </div>

        <div class="row mb-4 g-3">
            <div class="col-md-3"><div class="card border-primary shadow-sm"><div class="card-body text-center"><h3 class="text-primary">@contratos.Count(c => c.Activo)</h3><p class="mb-0">Contratos activos</p></div></div></div>
            <div class="col-md-3"><div class="card border-success shadow-sm"><div class="card-body text-center"><h3 class="text-success">@contratos.Count(c => c.TipoContrato == TipoContrato.Indefinido)</h3><p class="mb-0">Indefinidos</p></div></div></div>
            <div class="col-md-3"><div class="card border-warning shadow-sm"><div class="card-body text-center"><h3 class="text-warning">@contratos.Count(c => c.TipoContrato != TipoContrato.Indefinido)</h3><p class="mb-0">Temporales</p></div></div></div>
            <div class="col-md-3"><div class="card border-danger shadow-sm"><div class="card-body text-center"><h3 class="text-danger">@contratosProximosVencer</h3><p class="mb-0">Vencen en 30 dias</p></div></div></div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Trabajador</label><select class="form-select" @bind="filtroUsuarioId" @bind:after="FiltrarContratos"><option value="">Todos</option>@foreach (var u in trabajadores){<option value="@u.Id">@u.NombreCompleto</option>}</select></div>
                    <div class="col-md-4"><label class="form-label">Tipo de contrato</label><select class="form-select" @bind="filtroTipo" @bind:after="FiltrarContratos"><option value="">Todos</option>@foreach (TipoContrato t in Enum.GetValues<TipoContrato>()){<option value="@((int)t)">@FormatTipoContrato(t)</option>}</select></div>
                    <div class="col-md-4"><label class="form-label">Estado</label><select class="form-select" @bind="filtroActivo" @bind:after="FiltrarContratos"><option value="">Todos</option><option value="true">Activos</option><option value="false">Finalizados</option></select></div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (!contratosFiltrados.Any())
                {
                    <p class="text-center text-muted p-4">No hay contratos con los filtros seleccionados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Trabajador</th><th>Tipo</th><th>Jornada</th><th>Horas/sem</th><th>Salario bruto</th><th>Inicio</th><th>Fin</th><th>Centro</th><th>Estado</th><th>Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var contrato in contratosFiltrados)
                                {
                                    var proximoVencer = contrato.FechaFin.HasValue && contrato.FechaFin.Value <= DateOnly.FromDateTime(DateTime.Today.AddDays(30)) && contrato.FechaFin.Value >= DateOnly.FromDateTime(DateTime.Today);
                                    <tr class="@(proximoVencer ? "table-warning" : "")">
                                        <td><strong>@contrato.UsuarioNombreCompleto</strong></td>
                                        <td><span class="badge bg-info text-dark">@FormatTipoContrato(contrato.TipoContrato)</span></td>
                                        <td>@FormatJornada(contrato.Jornada)</td>
                                        <td>@contrato.HorasSemanales h</td>
                                        <td>@contrato.SalarioBrutoAnual.ToString("C0")</td>
                                        <td>@contrato.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@(contrato.FechaFin?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@(contrato.CentroTrabajo ?? "-")</td>
                                        <td>@if (contrato.Activo){<span class="badge bg-success">Activo</span>}else{<span class="badge bg-secondary">Finalizado</span>}</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarContrato(contrato)">Editar</button>
                                            @if (contrato.Activo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => FinalizarContrato(contrato)">Finalizar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (mostrarFormulario)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">@(editandoId > 0 ? "Editar" : "Nuevo") Contrato</h5><button type="button" class="btn-close" @onclick="CerrarFormulario"></button></div>
                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Trabajador *</label><select class="form-select" @bind="formUsuarioId" disabled="@(editandoId > 0)"><option value="">Seleccionar</option>@foreach (var u in trabajadores){<option value="@u.Id">@u.NombreCompleto</option>}</select></div>
                                <div class="col-md-6"><label class="form-label">Tipo de contrato *</label><select class="form-select" @bind="formTipoContrato">@foreach (TipoContrato t in Enum.GetValues<TipoContrato>()){<option value="@t">@FormatTipoContrato(t)</option>}</select></div>
                                <div class="col-md-4"><label class="form-label">Fecha inicio *</label><input type="date" class="form-control" @bind="fechaInicioForm" /></div>
                                <div class="col-md-4"><label class="form-label">Fecha fin</label><input type="date" class="form-control" @bind="fechaFinForm" /><small class="text-muted">Dejar en blanco para indefinido</small></div>
                                <div class="col-md-4"><label class="form-label">Salario bruto anual (€) *</label><input type="number" class="form-control" step="100" @bind="formSalarioBrutoAnual" /></div>
                                <div class="col-md-4"><label class="form-label">Jornada</label><select class="form-select" @bind="formJornada">@foreach (JornadaLaboral j in Enum.GetValues<JornadaLaboral>()){<option value="@j">@FormatJornada(j)</option>}</select></div>
                                <div class="col-md-4"><label class="form-label">Horas semanales</label><input type="number" class="form-control" step="0.5" @bind="formHorasSemanales" /></div>
                                <div class="col-md-4"><label class="form-label">Centro de trabajo</label><input type="text" class="form-control" @bind="formCentroTrabajo" /></div>
                                <div class="col-md-4"><label class="form-label">Categoria convenio</label><input type="text" class="form-control" @bind="formCategoriaConvenio" /></div>
                                <div class="col-md-4"><label class="form-label">Nº Seg. Social</label><input type="text" class="form-control" @bind="formNumeroSeguridadSocial" /></div>
                                <div class="col-12"><label class="form-label">Observaciones</label><textarea class="form-control" rows="2" @bind="formObservaciones"></textarea></div>
                            </div>
                        </div>
                        <div class="modal-footer"><button class="btn btn-secondary" @onclick="CerrarFormulario">Cancelar</button><button class="btn btn-primary" @onclick="GuardarContrato" disabled="@guardando">@if (guardando){<span class="spinner-border spinner-border-sm me-1"></span>}Guardar</button></div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
                <div class="toast show align-items-center text-bg-@(esError ? "danger" : "success") border-0" role="alert">
                    <div class="d-flex"><div class="toast-body">@mensaje</div><button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => mensaje = null"></button></div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool cargando = true;
    private bool mostrarFormulario;
    private bool guardando;
    private int editandoId;
    private string? mensaje;
    private bool esError;
    private List<UsuarioResumenDto> trabajadores = new();
    private List<ContratoResumenDto> contratos = new();
    private List<ContratoResumenDto> contratosFiltrados = new();
    private int contratosProximosVencer;
    private string filtroUsuarioId = string.Empty;
    private string filtroTipo = string.Empty;
    private string filtroActivo = "true";
    private string formUsuarioId = string.Empty;
    private TipoContrato formTipoContrato = TipoContrato.Indefinido;
    private JornadaLaboral formJornada = JornadaLaboral.Completa;
    private double formHorasSemanales = 40;
    private decimal formSalarioBrutoAnual;
    private string? formCentroTrabajo;
    private string? formCategoriaConvenio;
    private string? formNumeroSeguridadSocial;
    private string? formObservaciones;
    private DateTime? fechaInicioForm;
    private DateTime? fechaFinForm;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        cargando = false;
    }

    private async Task CargarDatos()
    {
        var response = await RRHHApiClient.ObtenerContratosAsync();
        trabajadores = response.Trabajadores;
        contratos = response.Contratos;
        contratosProximosVencer = response.ContratosProximosVencer;
        FiltrarContratos();
    }

    private void FiltrarContratos()
    {
        var query = contratos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(filtroUsuarioId)) query = query.Where(c => c.UsuarioId == filtroUsuarioId);
        if (!string.IsNullOrWhiteSpace(filtroTipo) && int.TryParse(filtroTipo, out var tipo)) query = query.Where(c => (int)c.TipoContrato == tipo);
        if (!string.IsNullOrWhiteSpace(filtroActivo)) query = query.Where(c => c.Activo == (filtroActivo == "true"));
        contratosFiltrados = query.ToList();
    }

    private void AbrirFormularioNuevo()
    {
        editandoId = 0;
        formUsuarioId = string.Empty;
        formTipoContrato = TipoContrato.Indefinido;
        formJornada = JornadaLaboral.Completa;
        formHorasSemanales = 40;
        formSalarioBrutoAnual = 0;
        formCentroTrabajo = null;
        formCategoriaConvenio = null;
        formNumeroSeguridadSocial = null;
        formObservaciones = null;
        fechaInicioForm = DateTime.Today;
        fechaFinForm = null;
        mostrarFormulario = true;
    }

    private void EditarContrato(ContratoResumenDto contrato)
    {
        editandoId = contrato.Id;
        formUsuarioId = contrato.UsuarioId;
        formTipoContrato = contrato.TipoContrato;
        formJornada = contrato.Jornada;
        formHorasSemanales = contrato.HorasSemanales;
        formSalarioBrutoAnual = contrato.SalarioBrutoAnual;
        formCentroTrabajo = contrato.CentroTrabajo;
        formCategoriaConvenio = contrato.CategoriaConvenio;
        formNumeroSeguridadSocial = contrato.NumeroSeguridadSocial;
        formObservaciones = contrato.Observaciones;
        fechaInicioForm = contrato.FechaInicio.ToDateTime(TimeOnly.MinValue);
        fechaFinForm = contrato.FechaFin?.ToDateTime(TimeOnly.MinValue);
        mostrarFormulario = true;
    }

    private void CerrarFormulario() => mostrarFormulario = false;

    private async Task GuardarContrato()
    {
        if (string.IsNullOrWhiteSpace(formUsuarioId))
        {
            MostrarMensaje("Selecciona un trabajador", true);
            return;
        }

        if (fechaInicioForm == null)
        {
            MostrarMensaje("La fecha de inicio es obligatoria", true);
            return;
        }

        guardando = true;
        var request = new GuardarContratoRequest
        {
            Id = editandoId,
            UsuarioId = formUsuarioId,
            TipoContrato = formTipoContrato,
            FechaInicio = DateOnly.FromDateTime(fechaInicioForm.Value),
            FechaFin = fechaFinForm.HasValue ? DateOnly.FromDateTime(fechaFinForm.Value) : null,
            SalarioBrutoAnual = formSalarioBrutoAnual,
            Jornada = formJornada,
            HorasSemanales = formHorasSemanales,
            CentroTrabajo = formCentroTrabajo,
            CategoriaConvenio = formCategoriaConvenio,
            NumeroSeguridadSocial = formNumeroSeguridadSocial,
            Observaciones = formObservaciones
        };

        var resultado = await RRHHApiClient.GuardarContratoAsync(request);
        MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
        if (resultado.Correcto)
        {
            mostrarFormulario = false;
            await CargarDatos();
        }
        guardando = false;
    }

    private async Task FinalizarContrato(ContratoResumenDto contrato)
    {
        var resultado = await RRHHApiClient.FinalizarContratoAsync(contrato.Id);
        MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
        if (resultado.Correcto)
        {
            await CargarDatos();
        }
    }

    private static string FormatTipoContrato(TipoContrato tipo) => tipo switch
    {
        TipoContrato.Indefinido => "Indefinido",
        TipoContrato.TempObraoServicio => "Obra/Servicio",
        TipoContrato.TempCircunstanciasProduccion => "Circunstancias Prod.",
        TipoContrato.FormacionAlternancia => "Form. Alternancia",
        TipoContrato.FormacionPractica => "Form. Practica",
        TipoContrato.Interinidad => "Interinidad",
        TipoContrato.FijoDiscontinuo => "Fijo Discontinuo",
        _ => tipo.ToString()
    };

    private static string FormatJornada(JornadaLaboral jornada) => jornada switch
    {
        JornadaLaboral.Completa => "Completa",
        JornadaLaboral.Parcial => "Parcial",
        JornadaLaboral.Reducida => "Reducida",
        _ => jornada.ToString()
    };

    private void MostrarMensaje(string msg, bool error)
    {
        mensaje = msg;
        esError = error;
        _ = Task.Delay(4000).ContinueWith(_ => { mensaje = null; InvokeAsync(StateHasChanged); });
    }

    private async Task ExportarContratosPdf()
    {
        var datos = contratosFiltrados.Select(c => new Contrato
        {
            Id = c.Id,
            UsuarioId = c.UsuarioId,
            Usuario = new UsuarioObra { Id = c.UsuarioId, NombreCompleto = c.UsuarioNombreCompleto },
            TipoContrato = c.TipoContrato,
            Jornada = c.Jornada,
            HorasSemanales = c.HorasSemanales,
            SalarioBrutoAnual = c.SalarioBrutoAnual,
            FechaInicio = c.FechaInicio,
            FechaFin = c.FechaFin,
            CentroTrabajo = c.CentroTrabajo,
            CategoriaConvenio = c.CategoriaConvenio,
            NumeroSeguridadSocial = c.NumeroSeguridadSocial,
            Observaciones = c.Observaciones,
            Activo = c.Activo,
            FechaCreacion = c.FechaCreacion,
            FechaModificacion = c.FechaModificacion
        }).OrderBy(c => c.Usuario?.NombreCompleto).ToList();
        var bytes = ExportPdf.GenerarInformeContratos(datos, "Contratos Laborales");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Contratos_{DateTime.Now:yyyyMMdd}.pdf", "application/pdf", base64);
    }

    private async Task ExportarContratosExcel()
    {
        var datos = contratosFiltrados.Select(c => new Contrato
        {
            Id = c.Id,
            UsuarioId = c.UsuarioId,
            Usuario = new UsuarioObra { Id = c.UsuarioId, NombreCompleto = c.UsuarioNombreCompleto },
            TipoContrato = c.TipoContrato,
            Jornada = c.Jornada,
            HorasSemanales = c.HorasSemanales,
            SalarioBrutoAnual = c.SalarioBrutoAnual,
            FechaInicio = c.FechaInicio,
            FechaFin = c.FechaFin,
            CentroTrabajo = c.CentroTrabajo,
            CategoriaConvenio = c.CategoriaConvenio,
            NumeroSeguridadSocial = c.NumeroSeguridadSocial,
            Observaciones = c.Observaciones,
            Activo = c.Activo,
            FechaCreacion = c.FechaCreacion,
            FechaModificacion = c.FechaModificacion
        }).OrderBy(c => c.Usuario?.NombreCompleto).ToList();
        var bytes = ExportExcel.GenerarExcelContratos(datos);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Contratos_{DateTime.Now:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }
}
