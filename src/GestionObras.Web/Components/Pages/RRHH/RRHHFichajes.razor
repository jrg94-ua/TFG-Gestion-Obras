@page "/rrhh/fichajes"
@attribute [Authorize(Roles = "RecursosHumanos,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Core.Contracts.JefeObra
@using GestionObras.Core.Contracts.RRHH
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject RRHHApiClient RRHHApiClient
@inject ExportPdfService ExportPdf
@inject ExportExcelService ExportExcel
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Control de Fichajes - RRHH</PageTitle>

@if (cargando)
{
    <div class="text-center p-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div><h1 class="text-primary">Control de Fichajes - RRHH</h1><p class="text-muted mb-0">Gestion y validacion de fichajes de toda la plantilla</p></div>
            <div class="btn-group">
                <button class="btn btn-outline-danger" @onclick="ExportarFichajesPdf"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button class="btn btn-outline-success" @onclick="ExportarFichajesExcel"><i class="bi bi-file-earmark-spreadsheet"></i> Excel</button>
            </div>
        </div>

        <div class="row mb-4 g-3">
            <div class="col-md-3"><div class="card border-success shadow-sm"><div class="card-body text-center"><h3 class="text-success">@fichajes.Count(f => f.HoraSalida == null)</h3><p class="mb-0">En jornada ahora</p></div></div></div>
            <div class="col-md-3"><div class="card border-primary shadow-sm"><div class="card-body text-center"><h3 class="text-primary">@fichajes.Count(f => f.HoraSalida != null)</h3><p class="mb-0">Jornadas completadas</p></div></div></div>
            <div class="col-md-3"><div class="card border-warning shadow-sm"><div class="card-body text-center"><h3 class="text-warning">@fichajes.Count(f => f.Estado == EstadoFichaje.Pendiente)</h3><p class="mb-0">Pendientes de validar</p></div></div></div>
            <div class="col-md-3"><div class="card border-info shadow-sm"><div class="card-body text-center"><h3 class="text-info">@(fichajes.Where(f => f.TotalHoras.HasValue).Sum(f => f.TotalHoras!.Value).ToString("F1")) h</h3><p class="mb-0">Horas totales</p></div></div></div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3"><label class="form-label">Proyecto</label><select class="form-select" @bind="filtroProyectoId" @bind:after="CargarFichajes"><option value="">Todos</option>@foreach (var p in proyectos){<option value="@p.Id">@p.Nombre</option>}</select></div>
                    <div class="col-md-2"><label class="form-label">Trabajador</label><select class="form-select" @bind="filtroUsuarioId" @bind:after="CargarFichajes"><option value="">Todos</option>@foreach (var u in trabajadores){<option value="@u.Id">@u.NombreCompleto</option>}</select></div>
                    <div class="col-md-2"><label class="form-label">Desde</label><input type="date" class="form-control" @bind="fechaDesde" @bind:after="CargarFichajes" /></div>
                    <div class="col-md-2"><label class="form-label">Hasta</label><input type="date" class="form-control" @bind="fechaHasta" @bind:after="CargarFichajes" /></div>
                    <div class="col-md-2"><label class="form-label">Estado</label><select class="form-select" @bind="filtroEstado" @bind:after="AplicarFiltroEstado"><option value="">Todos</option><option value="Pendiente">Pendiente</option><option value="Validado">Validado</option><option value="Rechazado">Rechazado</option></select></div>
                    <div class="col-md-1"><button class="btn btn-outline-success w-100" @onclick="ValidarTodosPendientes">Todo</button></div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (!fichajesFiltrados.Any())
                {
                    <p class="text-center text-muted p-4">No hay fichajes en el rango seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Trabajador</th><th>Fecha</th><th>Entrada</th><th>Salida</th><th>Proyecto</th><th>Horas</th><th>Estado</th><th>Acciones</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var fichaje in fichajesFiltrados)
                                {
                                    <tr class="@(fichaje.HoraSalida == null ? "table-success" : "")">
                                        <td><strong>@fichaje.UsuarioNombreCompleto</strong></td>
                                        <td>@fichaje.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@fichaje.HoraEntrada.ToString("HH:mm")</td>
                                        <td>@(fichaje.HoraSalida?.ToString("HH:mm") ?? "En curso")</td>
                                        <td>@(fichaje.ProyectoNombre ?? "-")</td>
                                        <td>@(fichaje.TotalHoras.HasValue ? $"{fichaje.TotalHoras:F1} h" : "-")</td>
                                        <td>
                                            @switch (fichaje.Estado)
                                            {
                                                case EstadoFichaje.Pendiente: <span class="badge bg-warning text-dark">Pendiente</span> break;
                                                case EstadoFichaje.Validado: <span class="badge bg-success">Validado</span> break;
                                                case EstadoFichaje.Rechazado: <span class="badge bg-danger">Rechazado</span> break;
                                            }
                                        </td>
                                        <td>
                                            @if (fichaje.Estado == EstadoFichaje.Pendiente && fichaje.HoraSalida != null)
                                            {
                                                <button class="btn btn-sm btn-success me-1" @onclick="() => CambiarEstado(fichaje, EstadoFichaje.Validado)">OK</button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => CambiarEstado(fichaje, EstadoFichaje.Rechazado)">NO</button>
                                            }
                                            @if (fichaje.Estado == EstadoFichaje.Rechazado)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => CambiarEstado(fichaje, EstadoFichaje.Validado)">Revertir</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
                <div class="toast show align-items-center text-bg-@(esError ? "danger" : "success") border-0" role="alert">
                    <div class="d-flex"><div class="toast-body">@mensaje</div><button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => mensaje = null"></button></div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool cargando = true;
    private string? mensaje;
    private bool esError;
    private List<ProyectoResumenDto> proyectos = new();
    private List<UsuarioResumenDto> trabajadores = new();
    private List<RegistroFichajeGestionDto> fichajes = new();
    private List<RegistroFichajeGestionDto> fichajesFiltrados = new();
    private string filtroProyectoId = string.Empty;
    private string filtroUsuarioId = string.Empty;
    private DateTime fechaDesde = DateTime.Today.AddDays(-7);
    private DateTime fechaHasta = DateTime.Today;
    private string filtroEstado = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarFichajes();
        cargando = false;
    }

    private async Task CargarFichajes()
    {
        int? proyectoId = int.TryParse(filtroProyectoId, out var pid) ? pid : null;
        var response = await RRHHApiClient.ObtenerFichajesAsync(DateOnly.FromDateTime(fechaDesde), DateOnly.FromDateTime(fechaHasta), proyectoId, filtroUsuarioId);
        proyectos = response.Proyectos;
        trabajadores = response.Trabajadores;
        fichajes = response.Fichajes;
        AplicarFiltroEstado();
    }

    private void AplicarFiltroEstado()
    {
        fichajesFiltrados = string.IsNullOrWhiteSpace(filtroEstado)
            ? fichajes
            : fichajes.Where(f => f.Estado.ToString() == filtroEstado).ToList();
    }

    private async Task CambiarEstado(RegistroFichajeGestionDto fichaje, EstadoFichaje nuevoEstado)
    {
        var resultado = await RRHHApiClient.CambiarEstadoFichajeAsync(fichaje.Id, nuevoEstado);
        MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
        if (resultado.Correcto)
        {
            await CargarFichajes();
        }
    }

    private async Task ValidarTodosPendientes()
    {
        int? proyectoId = int.TryParse(filtroProyectoId, out var pid) ? pid : null;
        var resultado = await RRHHApiClient.ValidarPendientesAsync(DateOnly.FromDateTime(fechaDesde), DateOnly.FromDateTime(fechaHasta), proyectoId, filtroUsuarioId);
        MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
        if (resultado.Correcto)
        {
            await CargarFichajes();
        }
    }

    private void MostrarMensaje(string msg, bool error)
    {
        mensaje = msg;
        esError = error;
        _ = Task.Delay(4000).ContinueWith(_ => { mensaje = null; InvokeAsync(StateHasChanged); });
    }

    private async Task ExportarFichajesPdf()
    {
        var datos = fichajesFiltrados.Select(f => new RegistroFichaje
        {
            Id = f.Id,
            UsuarioId = f.UsuarioId,
            Usuario = new UsuarioObra { Id = f.UsuarioId, NombreCompleto = f.UsuarioNombreCompleto },
            Fecha = f.Fecha,
            HoraEntrada = f.HoraEntrada,
            HoraSalida = f.HoraSalida,
            ProyectoId = f.ProyectoId,
            Proyecto = string.IsNullOrWhiteSpace(f.ProyectoNombre) ? null : new Proyecto { Id = f.ProyectoId ?? 0, Nombre = f.ProyectoNombre },
            Estado = f.Estado
        }).OrderBy(f => f.Usuario?.NombreCompleto).ThenByDescending(f => f.Fecha).ToList();
        var bytes = ExportPdf.GenerarInformeFichajes(datos, "Fichajes de Empleados");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Fichajes_{DateTime.Now:yyyyMMdd}.pdf", "application/pdf", base64);
    }

    private async Task ExportarFichajesExcel()
    {
        var datos = fichajesFiltrados.Select(f => new RegistroFichaje
        {
            Id = f.Id,
            UsuarioId = f.UsuarioId,
            Usuario = new UsuarioObra { Id = f.UsuarioId, NombreCompleto = f.UsuarioNombreCompleto },
            Fecha = f.Fecha,
            HoraEntrada = f.HoraEntrada,
            HoraSalida = f.HoraSalida,
            ProyectoId = f.ProyectoId,
            Proyecto = string.IsNullOrWhiteSpace(f.ProyectoNombre) ? null : new Proyecto { Id = f.ProyectoId ?? 0, Nombre = f.ProyectoNombre },
            Estado = f.Estado
        }).OrderBy(f => f.Usuario?.NombreCompleto).ThenByDescending(f => f.Fecha).ToList();
        var bytes = ExportExcel.GenerarExcelFichajes(datos);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Fichajes_{DateTime.Now:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }
}
