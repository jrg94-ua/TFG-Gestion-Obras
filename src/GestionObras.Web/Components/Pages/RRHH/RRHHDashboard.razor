@page "/rrhh/dashboard"
@attribute [Authorize(Roles = "RecursosHumanos,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Core.Contracts.RRHH
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject NavigationManager Navigation
@inject RRHHApiClient RRHHApiClient
@rendermode InteractiveServer

<PageTitle>Recursos Humanos - Gestion de Obras</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="dashboard-header mb-4">
        <h1 class="text-primary">Panel de Recursos Humanos</h1>
        <p class="text-muted">Gestion integral de personal, fichajes, horarios y contratos</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-primary shadow-sm h-100"><div class="card-body text-center"><div class="display-5 text-primary mb-2">T</div><h3 class="text-primary">@totalTrabajadores</h3><p class="mb-0">Trabajadores activos</p></div></div></div>
        <div class="col-md-3"><div class="card border-success shadow-sm h-100"><div class="card-body text-center"><div class="display-5 text-success mb-2">C</div><h3 class="text-success">@contratosActivos</h3><p class="mb-0">Contratos activos</p></div></div></div>
        <div class="col-md-3"><div class="card border-warning shadow-sm h-100"><div class="card-body text-center"><div class="display-5 text-warning mb-2">F</div><h3 class="text-warning">@fichajesPendientes</h3><p class="mb-0">Fichajes por validar</p></div></div></div>
        <div class="col-md-3"><div class="card border-info shadow-sm h-100"><div class="card-body text-center"><div class="display-5 text-info mb-2">J</div><h3 class="text-info">@enJornadaAhora</h3><p class="mb-0">En jornada ahora</p></div></div></div>
    </div>

    @if (contratosProximosVencer.Any())
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <div>
                <strong>Contratos proximos a vencer:</strong>
                @foreach (var contrato in contratosProximosVencer)
                {
                    <span class="badge bg-warning text-dark ms-2">@contrato.UsuarioNombreCompleto - @contrato.FechaFin?.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12"><h2 class="h5 mb-3">Acciones Rapidas</h2></div>
        <div class="col-md-3"><button class="btn btn-outline-primary w-100 py-3" @onclick='() => Navigation.NavigateTo("/rrhh/fichajes")'><div class="mb-1">F</div><strong>Control de Fichajes</strong><div class="small text-muted">Validar asistencia</div></button></div>
        <div class="col-md-3"><button class="btn btn-outline-success w-100 py-3" @onclick='() => Navigation.NavigateTo("/rrhh/horarios")'><div class="mb-1">H</div><strong>Gestion de Horarios</strong><div class="small text-muted">Turnos y jornadas</div></button></div>
        <div class="col-md-3"><button class="btn btn-outline-info w-100 py-3" @onclick='() => Navigation.NavigateTo("/rrhh/contratos")'><div class="mb-1">C</div><strong>Contratos</strong><div class="small text-muted">Gestion contractual</div></button></div>
        <div class="col-md-3"><button class="btn btn-outline-secondary w-100 py-3" @onclick='() => Navigation.NavigateTo("/empleados")'><div class="mb-1">P</div><strong>Plantilla</strong><div class="small text-muted">Ver empleados</div></button></div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Fichajes pendientes de hoy</h5>
                    <a href="/rrhh/fichajes" class="btn btn-sm btn-outline-primary">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    @if (!fichajesHoy.Any())
                    {
                        <p class="text-center text-muted p-4">No hay fichajes pendientes hoy.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Trabajador</th><th>Entrada</th><th>Salida</th><th>Estado</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var fichaje in fichajesHoy.Take(8))
                                {
                                    <tr>
                                        <td>@fichaje.UsuarioNombreCompleto</td>
                                        <td>@fichaje.HoraEntrada.ToString("HH:mm")</td>
                                        <td>@(fichaje.HoraSalida?.ToString("HH:mm") ?? "En curso")</td>
                                        <td>
                                            @if (fichaje.Estado == EstadoFichaje.Pendiente)
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                            else if (fichaje.Estado == EstadoFichaje.Validado)
                                            {
                                                <span class="badge bg-success">Validado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Contratos recientes</h5>
                    <a href="/rrhh/contratos" class="btn btn-sm btn-outline-info">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    @if (!contratosRecientes.Any())
                    {
                        <p class="text-center text-muted p-4">No hay contratos registrados.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th>Trabajador</th><th>Tipo</th><th>Inicio</th><th>Fin</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var contrato in contratosRecientes.Take(8))
                                {
                                    <tr>
                                        <td>@contrato.UsuarioNombreCompleto</td>
                                        <td><span class="badge bg-info text-dark">@FormatTipoContrato(contrato.TipoContrato)</span></td>
                                        <td>@contrato.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>@(contrato.FechaFin?.ToString("dd/MM/yyyy") ?? "Indefinido")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalTrabajadores;
    private int contratosActivos;
    private int fichajesPendientes;
    private int enJornadaAhora;
    private List<RegistroFichajeGestionDto> fichajesHoy = new();
    private List<ContratoResumenDto> contratosRecientes = new();
    private List<ContratoResumenDto> contratosProximosVencer = new();

    protected override async Task OnInitializedAsync()
    {
        var response = await RRHHApiClient.ObtenerDashboardAsync();
        totalTrabajadores = response.TotalTrabajadores;
        contratosActivos = response.ContratosActivos;
        fichajesPendientes = response.FichajesPendientes;
        enJornadaAhora = response.EnJornadaAhora;
        fichajesHoy = response.FichajesHoy;
        contratosRecientes = response.ContratosRecientes;
        contratosProximosVencer = response.ContratosProximosVencer;
    }

    private static string FormatTipoContrato(TipoContrato tipo) => tipo switch
    {
        TipoContrato.Indefinido => "Indefinido",
        TipoContrato.TempObraoServicio => "Obra/Servicio",
        TipoContrato.TempCircunstanciasProduccion => "Circunstancias Prod.",
        TipoContrato.FormacionAlternancia => "Form. Alternancia",
        TipoContrato.FormacionPractica => "Form. Practica",
        TipoContrato.Interinidad => "Interinidad",
        TipoContrato.FijoDiscontinuo => "Fijo Discontinuo",
        _ => tipo.ToString()
    };
}
