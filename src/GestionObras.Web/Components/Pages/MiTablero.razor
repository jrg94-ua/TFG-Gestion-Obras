@page "/mi-tablero"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using GestionObras.Core.Contracts.Administracion
@using GestionObras.Core.Entities
@using GestionObras.Web.Components.Shared
@using GestionObras.Web.Services
@inject AdministracionApiClient AdministracionApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ExportPdfService ExportPdf
@inject ExportExcelService ExportExcel
@rendermode InteractiveServer

<PageTitle>Mi Tablero Personal - Gestion de Obras</PageTitle>

@if (string.IsNullOrWhiteSpace(usuarioNombreCompleto))
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="kanban-container">
        <div class="kanban-header">
            <div>
                <h1>Mi Tablero Personal</h1>
                <p class="text-muted">
                    @if (esOperario)
                    {
                        <span>@usuarioNombreCompleto - Visor simple de tareas asignadas</span>
                    }
                    else
                    {
                        <span>@usuarioNombreCompleto - Mis tareas de todos los proyectos</span>
                    }
                </p>
            </div>
            @if (!esOperario)
            {
                <div class="btn-group" role="group" aria-label="Exportar tareas">
                    <button class="btn btn-outline-danger" @onclick="ExportarPdfTareas" title="Exportar tareas a PDF">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                    <button class="btn btn-outline-success" @onclick="ExportarExcelTareas" title="Exportar tareas a Excel">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                    </button>
                </div>
            }
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-secondary">
                    <div class="card-body text-center">
                        <h3 class="text-secondary">@misTareas.Count(t => t.Estado == EstadoTarea.Pendiente)</h3>
                        <p class="mb-0">Pendientes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h3 class="text-primary">@misTareas.Count(t => t.Estado == EstadoTarea.EnCurso)</h3>
                        <p class="mb-0">En Curso</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h3 class="text-warning">@misTareas.Count(t => t.Estado == EstadoTarea.Bloqueado)</h3>
                        <p class="mb-0">Bloqueadas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h3 class="text-success">@misTareas.Count(t => t.Estado == EstadoTarea.Finalizado)</h3>
                        <p class="mb-0">Finalizadas</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="kanban-filters">
            <div class="row g-3 w-100">
                <div class="col-md-4">
                    <label class="form-label">Buscar tarea:</label>
                    <input type="text" class="form-control" placeholder="Nombre o descripcion..." @bind="busqueda" @bind:event="oninput" @bind:after="AplicarFiltros" />
                </div>
                @if (!esOperario)
                {
                    <div class="col-md-4">
                        <label class="form-label">Filtrar por proyecto:</label>
                        <select class="form-select" @bind="proyectoFiltro" @bind:after="AplicarFiltros">
                            <option value="">Todos los proyectos</option>
                            @foreach (var proyecto in proyectos)
                            {
                                <option value="@proyecto.Id">@proyecto.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prioridad:</label>
                        <select class="form-select" @bind="prioridadFiltro" @bind:after="AplicarFiltros">
                            <option value="">Todas</option>
                            <option value="@PrioridadTarea.Critica">Critica</option>
                            <option value="@PrioridadTarea.Alta">Alta</option>
                            <option value="@PrioridadTarea.Media">Media</option>
                            <option value="@PrioridadTarea.Baja">Baja</option>
                        </select>
                    </div>
                }
            </div>
        </div>

        <div class="kanban-board">
            <div class="kanban-column" ondragover="event.preventDefault();" @ondrop="@(() => Drop(EstadoTarea.Pendiente))">
                <div class="kanban-column-header pendiente">
                    <h3>Pendiente</h3>
                    <span class="badge bg-secondary">@ObtenerTareasPorEstado(EstadoTarea.Pendiente).Count()</span>
                </div>
                <div class="kanban-column-body">
                    @foreach (var tarea in ObtenerTareasPorEstado(EstadoTarea.Pendiente))
                    {
                        <TarjetaTareaPersonal Tarea="@tarea" OnDragStart="@DragStart" OnEditar="@AbrirModalEditarTarea" OnVerProyecto="@VerProyecto"
                                              OnMarcarFinalizada="@MarcarComoFinalizada" ModoOperario="@esOperario" MostrarPresupuesto="@(!esOperario)"
                                              MostrarBotonVerProyecto="@(!esOperario)" PermitirArrastrar="@(!esOperario)" MostrarJerarquia="@(!esOperario)" />
                    }
                </div>
            </div>

            <div class="kanban-column" ondragover="event.preventDefault();" @ondrop="@(() => Drop(EstadoTarea.EnCurso))">
                <div class="kanban-column-header en-curso">
                    <h3>En Curso</h3>
                    <span class="badge bg-secondary">@ObtenerTareasPorEstado(EstadoTarea.EnCurso).Count()</span>
                </div>
                <div class="kanban-column-body">
                    @foreach (var tarea in ObtenerTareasPorEstado(EstadoTarea.EnCurso))
                    {
                        <TarjetaTareaPersonal Tarea="@tarea" OnDragStart="@DragStart" OnEditar="@AbrirModalEditarTarea" OnVerProyecto="@VerProyecto"
                                              OnMarcarFinalizada="@MarcarComoFinalizada" ModoOperario="@esOperario" MostrarPresupuesto="@(!esOperario)"
                                              MostrarBotonVerProyecto="@(!esOperario)" PermitirArrastrar="@(!esOperario)" MostrarJerarquia="@(!esOperario)" />
                    }
                </div>
            </div>

            <div class="kanban-column" ondragover="event.preventDefault();" @ondrop="@(() => Drop(EstadoTarea.Bloqueado))">
                <div class="kanban-column-header bloqueado">
                    <h3>Bloqueado</h3>
                    <span class="badge bg-secondary">@ObtenerTareasPorEstado(EstadoTarea.Bloqueado).Count()</span>
                </div>
                <div class="kanban-column-body">
                    @foreach (var tarea in ObtenerTareasPorEstado(EstadoTarea.Bloqueado))
                    {
                        <TarjetaTareaPersonal Tarea="@tarea" OnDragStart="@DragStart" OnEditar="@AbrirModalEditarTarea" OnVerProyecto="@VerProyecto"
                                              OnDesbloquear="@AbrirModalDesbloquear" OnMarcarFinalizada="@MarcarComoFinalizada" ModoOperario="@esOperario"
                                              MostrarPresupuesto="@(!esOperario)" MostrarBotonVerProyecto="@(!esOperario)" PermitirArrastrar="@(!esOperario)"
                                              MostrarJerarquia="@(!esOperario)" />
                    }
                </div>
            </div>

            <div class="kanban-column" ondragover="event.preventDefault();" @ondrop="@(() => Drop(EstadoTarea.Finalizado))">
                <div class="kanban-column-header finalizado">
                    <h3>Finalizado</h3>
                    <span class="badge bg-secondary">@ObtenerTareasPorEstado(EstadoTarea.Finalizado).Count()</span>
                </div>
                <div class="kanban-column-body">
                    @foreach (var tarea in ObtenerTareasPorEstado(EstadoTarea.Finalizado))
                    {
                        <TarjetaTareaPersonal Tarea="@tarea" OnDragStart="@DragStart" OnEditar="@AbrirModalEditarTarea" OnVerProyecto="@VerProyecto"
                                              OnMarcarFinalizada="@MarcarComoFinalizada" ModoOperario="@esOperario" MostrarPresupuesto="@(!esOperario)"
                                              MostrarBotonVerProyecto="@(!esOperario)" PermitirArrastrar="@(!esOperario)" MostrarJerarquia="@(!esOperario)" />
                    }
                </div>
            </div>
        </div>
    </div>

    @if (mostrarModalEditar)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar Tarea</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="@tareaEditando" OnValidSubmit="GuardarTarea">
                            <div class="alert alert-info">
                                <strong>Proyecto:</strong> @tareaEditando.ProyectoNombre
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nombre</label>
                                <InputText class="form-control" @bind-Value="tareaEditando.Nombre" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Descripcion</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="tareaEditando.Descripcion" readonly />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Estado *</label>
                                    <InputSelect class="form-select" @bind-Value="tareaEditando.Estado">
                                        <option value="@EstadoTarea.Pendiente">Pendiente</option>
                                        <option value="@EstadoTarea.EnCurso">En Curso</option>
                                        <option value="@EstadoTarea.Bloqueado">Bloqueado</option>
                                        <option value="@EstadoTarea.Finalizado">Finalizado</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Prioridad</label>
                                    <InputSelect class="form-select" @bind-Value="tareaEditando.Prioridad" disabled>
                                        <option value="@PrioridadTarea.Baja">Baja</option>
                                        <option value="@PrioridadTarea.Media">Media</option>
                                        <option value="@PrioridadTarea.Alta">Alta</option>
                                        <option value="@PrioridadTarea.Critica">Critica</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Fecha Inicio</label>
                                    <InputDate class="form-control" @bind-Value="tareaEditando.FechaInicio" disabled />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Fecha Fin</label>
                                    <InputDate class="form-control" @bind-Value="tareaEditando.FechaFin" disabled />
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Actualizar Estado
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (mostrarModalBloqueo)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title">Justificar Bloqueo de Tarea</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalBloqueo"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning">
                            <strong>RF-07:</strong> Es obligatorio justificar el bloqueo de una tarea.
                        </div>
                        <p><strong>Tarea:</strong> @tareaParaBloquear?.Nombre</p>
                        <p><strong>Proyecto:</strong> @tareaParaBloquear?.Proyecto.Nombre</p>
                        <div class="mb-3">
                            <label class="form-label">Tipo de Bloqueo *</label>
                            <select class="form-select" @bind="tipoBloqueoSeleccionado">
                                <option value="@TipoBloqueo.FaltaMaterial">Falta de Material</option>
                                <option value="@TipoBloqueo.ErrorEjecucion">Error de Ejecucion</option>
                                <option value="@TipoBloqueo.IncidenciaNormativa">Incidencia Normativa</option>
                                <option value="@TipoBloqueo.ClimatologiaAdversa">Climatologia Adversa</option>
                                <option value="@TipoBloqueo.Otro">Otro</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Justificacion Tecnica *</label>
                            <textarea class="form-control" rows="4" @bind="justificacionBloqueo" placeholder="Describa detalladamente el motivo del bloqueo..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalBloqueo">Cancelar</button>
                        <button type="button" class="btn btn-warning" @onclick="GuardarBloqueo">
                            <i class="bi bi-lock"></i> Bloquear Tarea
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (mostrarModalDesbloqueo)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">Desbloquear Tarea</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDesbloqueo"></button>
                    </div>
                    <div class="modal-body">
                        @if (tareaParaDesbloquear?.Bloqueo != null)
                        {
                            <div class="mb-3"><strong>Tarea:</strong> @tareaParaDesbloquear.Nombre</div>
                            <div class="mb-3"><strong>Proyecto:</strong> @tareaParaDesbloquear.Proyecto.Nombre</div>
                            <div class="mb-3"><strong>Motivo del bloqueo:</strong> @tareaParaDesbloquear.Bloqueo.Tipo</div>
                            <div class="mb-3"><strong>Justificacion:</strong><br />@tareaParaDesbloquear.Bloqueo.JustificacionTecnica</div>
                            <div class="mb-3"><strong>Fecha de bloqueo:</strong> @tareaParaDesbloquear.Bloqueo.FechaBloqueo.ToString("dd/MM/yyyy")</div>
                        }
                        <p class="text-success">Confirma que desea desbloquear esta tarea?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalDesbloqueo">Cancelar</button>
                        <button type="button" class="btn btn-success" @onclick="DesbloquearTarea">
                            <i class="bi bi-unlock"></i> Desbloquear
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    private string usuarioActualId = string.Empty;
    private string usuarioNombreCompleto = string.Empty;
    private bool esOperario;
    private List<TareaPersonalDto> misTareas = new();
    private List<TareaPersonalDto> tareasFiltradas = new();
    private List<ProyectoMinimoDto> proyectos = new();

    private string busqueda = string.Empty;
    private string proyectoFiltro = string.Empty;
    private string prioridadFiltro = string.Empty;

    private TareaPersonalDto? tareaArrastrada;
    private bool mostrarModalEditar;
    private TareaEditModel tareaEditando = new();
    private bool mostrarModalBloqueo;
    private TareaPersonalDto? tareaParaBloquear;
    private TipoBloqueo tipoBloqueoSeleccionado = TipoBloqueo.FaltaMaterial;
    private string justificacionBloqueo = string.Empty;
    private bool mostrarModalDesbloqueo;
    private TareaPersonalDto? tareaParaDesbloquear;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        usuarioActualId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(usuarioActualId))
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        var response = await AdministracionApi.ObtenerMiTableroAsync();
        usuarioNombreCompleto = response.UsuarioNombreCompleto;
        esOperario = response.EsOperario;
        misTareas = response.Tareas;
        proyectos = response.Proyectos;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        tareasFiltradas = misTareas.ToList();

        if (!string.IsNullOrWhiteSpace(busqueda))
        {
            tareasFiltradas = tareasFiltradas
                .Where(t => t.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
                            (t.Descripcion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        if (!string.IsNullOrWhiteSpace(proyectoFiltro) && int.TryParse(proyectoFiltro, out var proyectoId))
        {
            tareasFiltradas = tareasFiltradas.Where(t => t.ProyectoId == proyectoId).ToList();
        }

        if (!string.IsNullOrWhiteSpace(prioridadFiltro) && Enum.TryParse<PrioridadTarea>(prioridadFiltro, out var prioridad))
        {
            tareasFiltradas = tareasFiltradas.Where(t => t.Prioridad == prioridad).ToList();
        }
    }

    private List<TareaPersonalDto> ObtenerTareasPorEstado(EstadoTarea estado)
        => tareasFiltradas.Where(t => t.Estado == estado).OrderBy(t => t.Prioridad).ToList();

    private void DragStart(TareaPersonalDto tarea)
    {
        tareaArrastrada = tarea;
    }

    private async Task Drop(EstadoTarea nuevoEstado)
    {
        if (esOperario || tareaArrastrada == null)
        {
            return;
        }

        if (nuevoEstado == EstadoTarea.Bloqueado && tareaArrastrada.Estado != EstadoTarea.Bloqueado)
        {
            tareaParaBloquear = tareaArrastrada;
            mostrarModalBloqueo = true;
            tareaArrastrada = null;
            return;
        }

        var result = await AdministracionApi.CambiarEstadoTareaAsync(tareaArrastrada.Id, nuevoEstado);
        if (!result.Correcto)
        {
            await JS.InvokeVoidAsync("alert", result.Mensaje);
            tareaArrastrada = null;
            return;
        }

        await CargarDatos();
        tareaArrastrada = null;
    }

    private void AbrirModalEditarTarea(TareaPersonalDto tarea)
    {
        if (esOperario)
        {
            return;
        }

        tareaEditando = new TareaEditModel
        {
            Id = tarea.Id,
            Nombre = tarea.Nombre,
            Descripcion = tarea.Descripcion ?? string.Empty,
            Estado = tarea.Estado,
            Prioridad = tarea.Prioridad,
            FechaInicio = tarea.FechaInicio,
            FechaFin = tarea.FechaFin,
            ProyectoNombre = tarea.Proyecto.Nombre
        };
        mostrarModalEditar = true;
    }

    private async Task GuardarTarea()
    {
        if (esOperario)
        {
            return;
        }

        if (tareaEditando.Estado == EstadoTarea.Bloqueado)
        {
            var original = misTareas.FirstOrDefault(t => t.Id == tareaEditando.Id);
            if (original != null)
            {
                tareaParaBloquear = original;
                CerrarModal();
                mostrarModalBloqueo = true;
                return;
            }
        }

        var result = await AdministracionApi.CambiarEstadoTareaAsync(tareaEditando.Id, tareaEditando.Estado);
        if (!result.Correcto)
        {
            await JS.InvokeVoidAsync("alert", result.Mensaje);
            return;
        }

        await CargarDatos();
        CerrarModal();
        await JS.InvokeVoidAsync("alert", "Estado actualizado correctamente");
    }

    private void CerrarModal()
    {
        mostrarModalEditar = false;
        tareaEditando = new();
    }

    private async Task GuardarBloqueo()
    {
        if (esOperario || tareaParaBloquear == null || string.IsNullOrWhiteSpace(justificacionBloqueo))
        {
            await JS.InvokeVoidAsync("alert", "Debe proporcionar una justificacion tecnica");
            return;
        }

        var result = await AdministracionApi.BloquearTareaAsync(tareaParaBloquear.Id, new BloquearTareaPersonalRequest
        {
            Tipo = tipoBloqueoSeleccionado,
            JustificacionTecnica = justificacionBloqueo
        });

        if (!result.Correcto)
        {
            await JS.InvokeVoidAsync("alert", result.Mensaje);
            return;
        }

        await CargarDatos();
        CerrarModalBloqueo();
        await JS.InvokeVoidAsync("alert", "Tarea bloqueada correctamente");
    }

    private void CerrarModalBloqueo()
    {
        mostrarModalBloqueo = false;
        tareaParaBloquear = null;
        justificacionBloqueo = string.Empty;
    }

    private void AbrirModalDesbloquear(TareaPersonalDto tarea)
    {
        if (esOperario)
        {
            return;
        }

        tareaParaDesbloquear = tarea;
        mostrarModalDesbloqueo = true;
    }

    private async Task DesbloquearTarea()
    {
        if (esOperario || tareaParaDesbloquear == null)
        {
            return;
        }

        var result = await AdministracionApi.DesbloquearTareaAsync(tareaParaDesbloquear.Id);
        if (!result.Correcto)
        {
            await JS.InvokeVoidAsync("alert", result.Mensaje);
            return;
        }

        await CargarDatos();
        CerrarModalDesbloqueo();
        await JS.InvokeVoidAsync("alert", "Tarea desbloqueada correctamente");
    }

    private void CerrarModalDesbloqueo()
    {
        mostrarModalDesbloqueo = false;
        tareaParaDesbloquear = null;
    }

    private void VerProyecto(int proyectoId)
    {
        if (esOperario)
        {
            return;
        }

        Navigation.NavigateTo($"/proyectos/{proyectoId}/kanban");
    }

    private async Task MarcarComoFinalizada(TareaPersonalDto tarea)
    {
        if (!esOperario || tarea.Estado == EstadoTarea.Finalizado)
        {
            return;
        }

        var result = await AdministracionApi.FinalizarTareaOperarioAsync(tarea.Id);
        if (!result.Correcto)
        {
            await JS.InvokeVoidAsync("alert", result.Mensaje);
            return;
        }

        await CargarDatos();
        await JS.InvokeVoidAsync("alert", "Tarea marcada como terminada. Tu superior ya puede revisarla.");
    }

    private async Task ExportarPdfTareas()
    {
        if (esOperario)
        {
            await JS.InvokeVoidAsync("alert", "Los operarios no pueden exportar tareas.");
            return;
        }

        var datos = tareasFiltradas.OrderBy(t => t.Prioridad).ThenBy(t => t.FechaInicio).Select(MapTareaEntidad).ToList();
        var bytes = ExportPdf.GenerarInformeTareas(datos, "Mis Tareas");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"MisTareas_{DateTime.Now:yyyyMMdd}.pdf", "application/pdf", base64);
    }

    private async Task ExportarExcelTareas()
    {
        if (esOperario)
        {
            await JS.InvokeVoidAsync("alert", "Los operarios no pueden exportar tareas.");
            return;
        }

        var datos = tareasFiltradas.OrderBy(t => t.Prioridad).ThenBy(t => t.FechaInicio).Select(MapTareaEntidad).ToList();
        var bytes = ExportExcel.GenerarExcelTareas(datos, "Mis Tareas");
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"MisTareas_{DateTime.Now:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }

    private static Tarea MapTareaEntidad(TareaPersonalDto tarea) =>
        new()
        {
            Id = tarea.Id,
            Nombre = tarea.Nombre,
            Descripcion = tarea.Descripcion ?? string.Empty,
            Estado = tarea.Estado,
            FechaInicio = tarea.FechaInicio,
            FechaFin = tarea.FechaFin,
            PresupuestoEstimado = tarea.PresupuestoEstimado,
            CostesReales = tarea.CostesReales,
            ProyectoId = tarea.ProyectoId,
            Proyecto = new Proyecto { Id = tarea.Proyecto.Id, Nombre = tarea.Proyecto.Nombre },
            TareaPadreId = tarea.TareaPadreId,
            TareaPadre = string.IsNullOrWhiteSpace(tarea.TareaPadreNombre) ? null : new Tarea { Nombre = tarea.TareaPadreNombre },
            Nivel = tarea.Nivel,
            Prioridad = tarea.Prioridad,
            UsuariosAsignados = Enumerable.Range(0, tarea.UsuariosAsignadosCount).Select(_ => new UsuarioObra()).ToList(),
            Bloqueo = tarea.Bloqueo == null ? null : new BloqueoTarea
            {
                Id = tarea.Bloqueo.Id,
                Tipo = tarea.Bloqueo.Tipo,
                JustificacionTecnica = tarea.Bloqueo.JustificacionTecnica,
                FechaBloqueo = tarea.Bloqueo.FechaBloqueo,
                FechaResolucion = tarea.Bloqueo.FechaResolucion
            },
            CompletadaPorId = tarea.CompletadaPorId,
            FechaFinalizacion = tarea.FechaFinalizacion,
            ObservacionesFinalizacion = tarea.ObservacionesFinalizacion
        };

