@page "/empleados"
@using System.Security.Claims
@using GestionObras.Core.Contracts.Administracion
@using GestionObras.Core.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Web.Services
@attribute [Authorize(Roles = "Administrador,JefeObra,OficinaTecnica")]
@rendermode InteractiveServer
@inject AdministracionApiClient AdministracionApi
@inject AuthenticationStateProvider AuthStateProvider
@inject ExportPdfService ExportPdf
@inject ExportExcelService ExportExcel
@inject IJSRuntime JS

<PageTitle>Empleados - Gestion Obras</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-people"></i> Gestion Jerarquica de Empleados
        </h1>
        <div class="d-flex gap-2">
            <div class="btn-group">
                <button class="btn btn-outline-danger" @onclick="ExportarPdf" title="Exportar a PDF">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
                <button class="btn btn-outline-success" @onclick="ExportarExcel" title="Exportar a Excel">
                    <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                </button>
            </div>
            <button class="btn btn-primary" @onclick="AbrirModalNuevo">
                <i class="bi bi-plus-circle"></i> Nuevo Empleado
            </button>
        </div>
    </div>

    <div class="alert alert-primary">
        <i class="bi bi-diagram-3"></i>
        <strong>Vista jerarquica:</strong> @descripcionJerarquiaActual
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" placeholder="Buscar por nombre..."
                           @bind="filtroNombre" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filtroEstado">
                        <option value="">Todos los estados</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando empleados...</p>
                </div>
            }
            else if (!empleadosFiltrados.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i> No se encontraron empleados
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>DNI</th>
                                <th>Email</th>
                                <th>Telefono</th>
                                <th>Departamento</th>
                                <th>Cargo</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empleado in empleadosFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-2">
                                                @ObtenerIniciales(empleado)
                                            </div>
                                            <strong>@empleado.Nombre @empleado.Apellidos</strong>
                                        </div>
                                    </td>
                                    <td>@empleado.DNI</td>
                                    <td>@empleado.Email</td>
                                    <td>@empleado.Telefono</td>
                                    <td><span class="badge bg-info">@empleado.Departamento</span></td>
                                    <td>@empleado.Cargo</td>
                                    <td>
                                        @if (empleado.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalEditar(empleado)" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(empleado)" title="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(empleadoSeleccionado.Id == 0 ? "Nuevo Empleado" : "Editar Empleado")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Nombre" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Apellidos *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Apellidos" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">DNI *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.DNI" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" @bind="empleadoSeleccionado.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Telefono *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Telefono" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Contratacion *</label>
                            <input type="date" class="form-control" @bind="empleadoSeleccionado.FechaContratacion" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Departamento *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Departamento" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cargo *</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Cargo" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Direccion</label>
                            <input class="form-control" @bind="empleadoSeleccionado.Direccion" />
                        </div>
                        <div class="col-md-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="empleadoSeleccionado.Activo" />
                                <label class="form-check-label">Empleado activo</label>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMensaje))
                    {
                        <div class="alert alert-danger mt-3">@errorMensaje</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarEmpleado">
                        <i class="bi bi-save2"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar eliminacion</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>Esta seguro de que desea eliminar al empleado?</p>
                    <p class="fw-bold">@empleadoAEliminar?.Nombre @empleadoAEliminar?.Apellidos</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarEmpleado">
                        <i class="bi bi-trash3-fill"></i> Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EmpleadoViewModel> empleados = new();
    private bool cargando = true;
    private bool mostrarModal;
    private bool mostrarModalEliminar;
    private EmpleadoViewModel empleadoSeleccionado = new();
    private EmpleadoViewModel? empleadoAEliminar;
    private string? errorMensaje;
    private string usuarioActualId = string.Empty;

    private string filtroNombre = string.Empty;
    private string filtroEstado = string.Empty;
    private string descripcionJerarquiaActual = "Cargando jerarquia...";

    private IEnumerable<EmpleadoViewModel> empleadosFiltrados => empleados
        .Where(e => string.IsNullOrEmpty(filtroNombre) ||
                   $"{e.Nombre} {e.Apellidos}".Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrEmpty(filtroEstado) || e.Activo.ToString().Equals(filtroEstado, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpleados();
    }

    private async Task CargarEmpleados()
    {
        cargando = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioActualId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        var response = await AdministracionApi.ObtenerEmpleadosAsync();
        descripcionJerarquiaActual = response.DescripcionJerarquiaActual;
        empleados = response.Empleados.Select(MapEmpleado).ToList();

        cargando = false;
    }

    private void AbrirModalNuevo()
    {
        empleadoSeleccionado = new EmpleadoViewModel
        {
            FechaContratacion = DateTime.Today,
            Activo = true
        };
        errorMensaje = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(EmpleadoViewModel empleado)
    {
        empleadoSeleccionado = new EmpleadoViewModel
        {
            Id = empleado.Id,
            UsuarioId = empleado.UsuarioId,
            Nombre = empleado.Nombre,
            Apellidos = empleado.Apellidos,
            DNI = empleado.DNI,
            Email = empleado.Email,
            Telefono = empleado.Telefono,
            FechaContratacion = empleado.FechaContratacion,
            Departamento = empleado.Departamento,
            Cargo = empleado.Cargo,
            Direccion = empleado.Direccion,
            Activo = empleado.Activo
        };
        errorMensaje = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        empleadoSeleccionado = new();
        errorMensaje = null;
    }

    private async Task GuardarEmpleado()
    {
        var result = await AdministracionApi.GuardarEmpleadoAsync(new GuardarEmpleadoRequest
        {
            UsuarioId = empleadoSeleccionado.UsuarioId,
            Nombre = empleadoSeleccionado.Nombre,
            Apellidos = empleadoSeleccionado.Apellidos,
            DNI = empleadoSeleccionado.DNI,
            Email = empleadoSeleccionado.Email,
            Telefono = empleadoSeleccionado.Telefono,
            FechaContratacion = empleadoSeleccionado.FechaContratacion,
            Departamento = empleadoSeleccionado.Departamento,
            Cargo = empleadoSeleccionado.Cargo,
            Direccion = empleadoSeleccionado.Direccion,
            Activo = empleadoSeleccionado.Activo
        });

        if (!result.Correcto)
        {
            errorMensaje = result.Mensaje;
            return;
        }

        await CargarEmpleados();
        CerrarModal();
    }

    private void ConfirmarEliminar(EmpleadoViewModel empleado)
    {
        empleadoAEliminar = empleado;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        empleadoAEliminar = null;
    }

    private async Task EliminarEmpleado()
    {
        if (empleadoAEliminar == null || string.IsNullOrWhiteSpace(empleadoAEliminar.UsuarioId))
        {
            CerrarModalEliminar();
            return;
        }

        await AdministracionApi.DesactivarEmpleadoAsync(empleadoAEliminar.UsuarioId);
        await CargarEmpleados();
        CerrarModalEliminar();
    }

    private void LimpiarFiltros()
    {
        filtroNombre = string.Empty;
        filtroEstado = string.Empty;
    }

    private static string ObtenerIniciales(EmpleadoViewModel empleado)
    {
        var inicialNombre = string.IsNullOrWhiteSpace(empleado.Nombre) ? "?" : empleado.Nombre.Substring(0, 1).ToUpper();
        var inicialApellido = string.IsNullOrWhiteSpace(empleado.Apellidos) ? "?" : empleado.Apellidos.Substring(0, 1).ToUpper();
        return $"{inicialNombre}{inicialApellido}";
    }

    private async Task ExportarPdf()
    {
        var datos = empleadosFiltrados.Select(MapEmpleadoEntidad).ToList();
        var bytes = ExportPdf.GenerarInformeEmpleados(datos);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Empleados_{DateTime.Now:yyyyMMdd}.pdf", "application/pdf", base64);
    }

    private async Task ExportarExcel()
    {
        var datos = empleadosFiltrados.Select(MapEmpleadoEntidad).ToList();
        var bytes = ExportExcel.GenerarExcelEmpleados(datos);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("descargarArchivo", $"Empleados_{DateTime.Now:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
    }

    private static EmpleadoViewModel MapEmpleado(EmpleadoGestionDto empleado) =>
        new()
        {
            Id = empleado.Id,
            UsuarioId = empleado.UsuarioId,
            Nombre = empleado.Nombre,
            Apellidos = empleado.Apellidos,
            DNI = empleado.DNI,
            Email = empleado.Email,
            Telefono = empleado.Telefono,
            FechaContratacion = empleado.FechaContratacion,
            Departamento = empleado.Departamento,
            Cargo = empleado.Cargo,
            Direccion = empleado.Direccion,
            Activo = empleado.Activo
        };

    private static Empleado MapEmpleadoEntidad(EmpleadoViewModel empleado) =>
        new()
        {
            Id = empleado.Id,
            Nombre = empleado.Nombre,
            Apellidos = empleado.Apellidos,
            DNI = empleado.DNI,
            Email = empleado.Email,
            Telefono = empleado.Telefono,
            FechaContratacion = empleado.FechaContratacion,
            Departamento = empleado.Departamento,
            Cargo = empleado.Cargo,
            Direccion = empleado.Direccion,
            Activo = empleado.Activo
        };

    private sealed class EmpleadoViewModel
    {
        public int Id { get; set; }
        public string UsuarioId { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string DNI { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public DateTime FechaContratacion { get; set; } = DateTime.Today;
        public string Departamento { get; set; } = string.Empty;
        public string Cargo { get; set; } = string.Empty;
        public string? Direccion { get; set; }
        public bool Activo { get; set; } = true;
    }
}
