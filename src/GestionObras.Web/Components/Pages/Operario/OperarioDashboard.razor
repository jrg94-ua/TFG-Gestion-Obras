@page "/operario/dashboard"
@attribute [Authorize(Roles = "Operario,OperarioObra,OperarioOficinaT,JefeObra,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using GestionObras.Core.Contracts.Operario
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject OperarioApiClient OperarioApiClient
@rendermode InteractiveServer

<PageTitle>Mi Panel - Gestion de Obras</PageTitle>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary mb-1">Hola, @nombreUsuario</h1>
                <p class="text-muted mb-0">Tu resumen del dia - @DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
            </div>
            <button class="btn btn-success btn-lg" @onclick='() => Navigation.NavigateTo("/fichaje")'>
                <i class="bi bi-clock me-1"></i> Fichar
            </button>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #ffc107 !important;">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="display-6">P</div>
                        <div><h3 class="mb-0">@tareasPendientes</h3><small class="text-muted">Pendientes</small></div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #0d6efd !important;">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="display-6">C</div>
                        <div><h3 class="mb-0">@tareasEnCurso</h3><small class="text-muted">En curso</small></div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #198754 !important;">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="display-6">F</div>
                        <div><h3 class="mb-0">@tareasCompletadas</h3><small class="text-muted">Completadas</small></div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #6f42c1 !important;">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="display-6">H</div>
                        <div><h3 class="mb-0">@horasSemanales.ToString("F0") h</h3><small class="text-muted">Horas/semana</small></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-semibold">Mis Tareas Activas</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/mi-tablero")'>Ver tablero</button>
                    </div>
                    <div class="card-body p-0">
                        @if (!misTareas.Any())
                        {
                            <div class="text-center text-muted p-4">
                                <div class="display-4 mb-2">OK</div>
                                <p>No tienes tareas pendientes</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr><th>Tarea</th><th>Proyecto</th><th>Estado</th><th>Inicio</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tarea in misTareas)
                                        {
                                            <tr>
                                                <td><strong>@tarea.Nombre</strong></td>
                                                <td>@tarea.ProyectoNombre</td>
                                                <td><span class="badge @GetBadge(tarea.Estado)">@tarea.Estado</span></td>
                                                <td>@tarea.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-semibold">Mi Horario Semanal</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (!misHorarios.Any())
                        {
                            <div class="text-center text-muted p-4">
                                <p>Sin horarios asignados</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (DiaSemana dia in Enum.GetValues<DiaSemana>())
                                {
                                    var turnos = misHorarios.Where(h => h.DiaSemana == dia).ToList();
                                    if (turnos.Any())
                                    {
                                        var esHoy = dia == DiaSemanaHoy();
                                        <div class="list-group-item @(esHoy ? "list-group-item-success" : "")">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong>@dia @(esHoy ? " <- HOY" : "")</strong>
                                            </div>
                                            @foreach (var horario in turnos)
                                            {
                                                <small class="d-block text-muted">
                                                    @TurnoIcon(horario.TipoTurno)
                                                    @horario.HoraEntrada.ToString("HH:mm") - @horario.HoraSalida.ToString("HH:mm")
                                                    @if (!string.IsNullOrWhiteSpace(horario.ProyectoNombre))
                                                    {
                                                        <text>(@horario.ProyectoNombre)</text>
                                                    }
                                                </small>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-semibold">Ultimo Fichaje</h5>
                    </div>
                    <div class="card-body">
                        @if (ultimoFichaje != null)
                        {
                            <p class="mb-1"><strong>Entrada:</strong> @ultimoFichaje.HoraEntrada.ToString("dd/MM HH:mm")</p>
                            @if (ultimoFichaje.HoraSalida.HasValue)
                            {
                                <p class="mb-1"><strong>Salida:</strong> @ultimoFichaje.HoraSalida.Value.ToString("dd/MM HH:mm")</p>
                                <p class="mb-0 text-muted"><strong>Duracion:</strong> @((ultimoFichaje.HoraSalida.Value - ultimoFichaje.HoraEntrada).ToString(@"hh\:mm")) h</p>
                            }
                            else
                            {
                                <span class="badge bg-success">En turno activo</span>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Sin fichajes recientes</p>
                        }
                    </div>
                </div>

                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/mi-tablero")'>
                                Mi Tablero
                            </button>
                            <button class="btn btn-outline-success" @onclick='() => Navigation.NavigateTo("/fichaje")'>
                                Fichaje
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private string nombreUsuario = string.Empty;
    private string? userId;
    private int tareasPendientes;
    private int tareasEnCurso;
    private int tareasCompletadas;
    private double horasSemanales;
    private List<TareaResumenDto> misTareas = new();
    private List<HorarioResumenDto> misHorarios = new();
    private RegistroFichajeResumenDto? ultimoFichaje;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(userId))
        {
            await CargarDatos();
        }

        cargando = false;
    }

    private async Task CargarDatos()
    {
        var response = await OperarioApiClient.ObtenerDashboardAsync();
        nombreUsuario = response.NombreUsuario;
        tareasPendientes = response.TareasPendientes;
        tareasEnCurso = response.TareasEnCurso;
        tareasCompletadas = response.TareasCompletadas;
        horasSemanales = response.HorasSemanales;
        misTareas = response.TareasActivas;
        misHorarios = response.HorariosSemanales;
        ultimoFichaje = response.UltimoFichaje;
    }

    private static DiaSemana DiaSemanaHoy() => DateTime.Now.DayOfWeek switch
    {
        DayOfWeek.Monday => DiaSemana.Lunes,
        DayOfWeek.Tuesday => DiaSemana.Martes,
        DayOfWeek.Wednesday => DiaSemana.Miercoles,
        DayOfWeek.Thursday => DiaSemana.Jueves,
        DayOfWeek.Friday => DiaSemana.Viernes,
        DayOfWeek.Saturday => DiaSemana.Sabado,
        DayOfWeek.Sunday => DiaSemana.Domingo,
        _ => DiaSemana.Lunes
    };

    private static string GetBadge(EstadoTarea estado) => estado switch
    {
        EstadoTarea.EnCurso => "bg-primary",
        EstadoTarea.Pendiente => "bg-warning text-dark",
        EstadoTarea.Finalizado => "bg-success",
        EstadoTarea.Bloqueado => "bg-danger",
        _ => "bg-secondary"
    };

    private static string TurnoIcon(TipoTurno turno) => turno switch
    {
        TipoTurno.Mañana => "M",
        TipoTurno.Tarde => "T",
        TipoTurno.Noche => "N",
        TipoTurno.Partido => "P",
        _ => string.Empty
    };
}
