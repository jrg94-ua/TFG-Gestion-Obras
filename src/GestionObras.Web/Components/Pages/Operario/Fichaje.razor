@page "/fichaje"
@attribute [Authorize(Roles = "Operario,OperarioObra,OperarioOficinaT,JefeObra,OficinaTecnica,RecursosHumanos,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using GestionObras.Core.Contracts.Operario
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject OperarioApiClient OperarioApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Fichaje - Gestion de Obras</PageTitle>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary"><i class="bi bi-clock-history"></i> Fichaje de Jornada</h1>
                <p class="text-muted mb-0">@nombreUsuario - @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
        </div>

        <div class="row justify-content-center mb-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0" style="border-radius: 16px;">
                    <div class="card-body text-center p-5">
                        @if (fichajeAbierto != null)
                        {
                            <div class="mb-3">
                                <span class="badge bg-success fs-5 px-4 py-2">Jornada en curso</span>
                            </div>
                            <p class="text-muted">Entrada: <strong>@fichajeAbierto.HoraEntrada.ToString("HH:mm")</strong></p>
                            @if (!string.IsNullOrWhiteSpace(fichajeAbierto.ProyectoNombre))
                            {
                                <p class="text-muted">Proyecto: <strong>@fichajeAbierto.ProyectoNombre</strong></p>
                            }
                            <p class="display-4 fw-bold text-primary my-3" id="reloj-jornada">
                                @((DateTime.Now - fichajeAbierto.HoraEntrada).ToString(@"hh\:mm\:ss"))
                            </p>
                            <button class="btn btn-danger btn-lg px-5 py-3" @onclick="FicharSalida" disabled="@procesando">
                                @if (procesando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Fichar Salida
                            </button>
                        }
                        else
                        {
                            <div class="mb-3">
                                <span class="badge bg-secondary fs-5 px-4 py-2">Sin fichar</span>
                            </div>
                            <p class="display-4 fw-bold text-muted my-3">--:--:--</p>

                            @if (proyectosDisponibles.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label">Proyecto</label>
                                    <select class="form-select" @bind="proyectoSeleccionadoId">
                                        <option value="">Sin proyecto</option>
                                        @foreach (var proyecto in proyectosDisponibles)
                                        {
                                            <option value="@proyecto.Id">@proyecto.Nombre</option>
                                        }
                                    </select>
                                </div>
                            }
                            <button class="btn btn-success btn-lg px-5 py-3" @onclick="FicharEntrada" disabled="@procesando">
                                @if (procesando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Fichar Entrada
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (horarioHoy.Any())
        {
            <div class="row justify-content-center mb-4">
                <div class="col-md-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">Mi horario de hoy</h5>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Turno</th>
                                        <th>Entrada</th>
                                        <th>Salida</th>
                                        <th>Proyecto</th>
                                        <th>Horas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var horario in horarioHoy)
                                    {
                                        <tr>
                                            <td><span class="badge bg-primary">@horario.TipoTurno</span></td>
                                            <td>@horario.HoraEntrada.ToString("HH:mm")</td>
                                            <td>@horario.HoraSalida.ToString("HH:mm")</td>
                                            <td>@(horario.ProyectoNombre ?? "General")</td>
                                            <td>@horario.HorasPrevistas.ToString("F1") h</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Historial de fichajes (ultimos 7 dias)</h5>
                        <span class="badge bg-secondary">@historial.Count registros</span>
                    </div>
                    <div class="card-body p-0">
                        @if (!historial.Any())
                        {
                            <p class="text-center text-muted p-4">No hay fichajes en los ultimos 7 dias.</p>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Entrada</th>
                                        <th>Salida</th>
                                        <th>Proyecto</th>
                                        <th>Horas</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fichaje in historial)
                                    {
                                        <tr>
                                            <td>@fichaje.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@fichaje.HoraEntrada.ToString("HH:mm")</td>
                                            <td>@(fichaje.HoraSalida?.ToString("HH:mm") ?? "-")</td>
                                            <td>@(fichaje.ProyectoNombre ?? "-")</td>
                                            <td>@(fichaje.TotalHoras.HasValue ? $"{fichaje.TotalHoras:F1} h" : "-")</td>
                                            <td>
                                                @switch (fichaje.Estado)
                                                {
                                                    case EstadoFichaje.Pendiente:
                                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                                        break;
                                                    case EstadoFichaje.Validado:
                                                        <span class="badge bg-success">Validado</span>
                                                        break;
                                                    case EstadoFichaje.Rechazado:
                                                        <span class="badge bg-danger">Rechazado</span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
                <div class="toast show align-items-center text-bg-@(esError ? "danger" : "success") border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">@mensaje</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => mensaje = null"></button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string? usuarioActualId;
    private string nombreUsuario = string.Empty;
    private RegistroFichajeResumenDto? fichajeAbierto;
    private List<RegistroFichajeResumenDto> historial = new();
    private List<HorarioResumenDto> horarioHoy = new();
    private List<GestionObras.Core.Contracts.JefeObra.ProyectoResumenDto> proyectosDisponibles = new();
    private int? proyectoSeleccionadoId;
    private bool cargando = true;
    private bool procesando;
    private string? mensaje;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioActualId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(usuarioActualId))
        {
            await CargarDatos();
        }

        cargando = false;
    }

    private async Task CargarDatos()
    {
        var response = await OperarioApiClient.ObtenerFichajeAsync();
        nombreUsuario = response.NombreUsuario;
        fichajeAbierto = response.FichajeAbierto;
        historial = response.Historial;
        horarioHoy = response.HorarioHoy;
        proyectosDisponibles = response.ProyectosDisponibles;
    }

    private async Task FicharEntrada()
    {
        procesando = true;
        try
        {
            var resultado = await OperarioApiClient.FicharEntradaAsync(proyectoSeleccionadoId);
            MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
            if (resultado.Correcto)
            {
                await CargarDatos();
            }
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task FicharSalida()
    {
        procesando = true;
        try
        {
            var resultado = await OperarioApiClient.FicharSalidaAsync();
            MostrarMensaje(resultado.Mensaje, !resultado.Correcto);
            if (resultado.Correcto)
            {
                await CargarDatos();
            }
        }
        finally
        {
            procesando = false;
        }
    }

    private void MostrarMensaje(string msg, bool error)
    {
        mensaje = msg;
        esError = error;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensaje = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
