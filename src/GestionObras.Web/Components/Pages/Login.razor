@page "/login"
@using Microsoft.AspNetCore.Identity
@using GestionObras.Core.Entities
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject SignInManager<UsuarioObra> SignInManager
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Iniciar Sesion - Gestion de Obras</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <div class="login-form-panel">
            <div class="login-card">
                <div class="login-header">
                    <h2>Gestion de Obras</h2>
                    <p>Inicia sesion para continuar</p>
                </div>

                <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="loginForm">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label for="email" class="form-label fw-semibold">Correo Electronico</label>
                        <InputText id="email" class="form-control form-control-lg" @bind-Value="loginModel.Email" placeholder="usuario@ejemplo.com" />
                        <ValidationMessage For="@(() => loginModel.Email)" />
                    </div>

                    <div class="form-group mb-3">
                        <label for="password" class="form-label fw-semibold">Contrasena</label>
                        <InputText id="password" type="password" class="form-control form-control-lg" @bind-Value="loginModel.Password" placeholder="********" />
                        <ValidationMessage For="@(() => loginModel.Password)" />
                    </div>

                    <div class="form-group form-check mb-3">
                        <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="loginModel.RememberMe" />
                        <label class="form-check-label" for="rememberMe">Recordarme</label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span> Iniciando sesion...</span>
                        }
                        else
                        {
                            <span>Iniciar Sesion</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>

        @if (mostrarAyudaDemo)
        {
            <div class="login-demo-panel">
                <h3 class="text-center mb-1" style="color: #2c3e50;">Acceso rapido demo</h3>
                <p class="text-center text-muted mb-3" style="font-size: 0.85rem;">Haz clic en una tarjeta para rellenar el correo. Las credenciales de demo deben consultarse en documentacion controlada.</p>

                <div class="demo-users-grid">
                    <div class="demo-user-card demo-admin" onclick="fillLoginEmail('admin@gestionobras.com')">
                        <div class="demo-icon">A</div>
                        <div class="demo-info">
                            <span class="demo-role">Administrador</span>
                            <span class="demo-name">Direccion General</span>
                            <span class="demo-email">admin@gestionobras.com</span>
                        </div>
                    </div>

                    <div class="demo-user-card demo-jefe" onclick="fillLoginEmail('jefe.norte@gestionobras.com')">
                        <div class="demo-icon">J</div>
                        <div class="demo-info">
                            <span class="demo-role">Jefe de Obra</span>
                            <span class="demo-name">Alvaro Molina Serrano</span>
                            <span class="demo-email">jefe.norte@gestionobras.com</span>
                        </div>
                    </div>

                    <div class="demo-user-card demo-oficina" onclick="fillLoginEmail('oficina.senior@gestionobras.com')">
                        <div class="demo-icon">O</div>
                        <div class="demo-info">
                            <span class="demo-role">Oficina Tecnica</span>
                            <span class="demo-name">Lucia Sanchis Ferrer</span>
                            <span class="demo-email">oficina.senior@gestionobras.com</span>
                        </div>
                    </div>

                    <div class="demo-user-card demo-rrhh" onclick="fillLoginEmail('rrhh@gestionobras.com')">
                        <div class="demo-icon">R</div>
                        <div class="demo-info">
                            <span class="demo-role">Recursos Humanos</span>
                            <span class="demo-name">Elena Martinez Garcia</span>
                            <span class="demo-email">rrhh@gestionobras.com</span>
                        </div>
                    </div>

                    <div class="demo-user-card demo-operario" onclick="fillLoginEmail('obra.01@gestionobras.com')">
                        <div class="demo-icon">W</div>
                        <div class="demo-info">
                            <span class="demo-role">Operario de Obra</span>
                            <span class="demo-name">Ivan Quintana Beltran</span>
                            <span class="demo-email">obra.01@gestionobras.com</span>
                        </div>
                    </div>

                    <div class="demo-user-card demo-operariot" onclick="fillLoginEmail('ot.01@gestionobras.com')">
                        <div class="demo-icon">T</div>
                        <div class="demo-info">
                            <span class="demo-role">Operario Oficina Tecnica</span>
                            <span class="demo-name">Paula Cuesta Leon</span>
                            <span class="demo-email">ot.01@gestionobras.com</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function fillLoginEmail(email) {
        var emailInput = document.getElementById('email');
        if (emailInput) {
            var nativeEmailSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
            nativeEmailSetter.call(emailInput, email);
            emailInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        var cards = document.querySelectorAll('.demo-user-card');
        cards.forEach(function(c) { c.classList.remove('selected'); });
        if (event && event.currentTarget) {
            event.currentTarget.classList.add('selected');
        }
    }
</script>

<style>
    .login-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .login-wrapper {
        display: flex;
        gap: 2rem;
        max-width: 1100px;
        width: 100%;
        align-items: stretch;
    }

    .login-form-panel {
        flex: 0 0 380px;
        display: flex;
        align-items: center;
    }

    .login-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        width: 100%;
    }

    .login-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .login-header h2 {
        font-size: 1.6rem;
        color: #2c3e50;
        margin-bottom: 0.25rem;
    }

    .login-header p {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .login-demo-panel {
        flex: 1;
        background: rgba(255,255,255,0.95);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .demo-users-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .demo-user-card {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 0.85rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: #fff;
    }

    .demo-user-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    }

    .demo-user-card.selected {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13,110,253,0.25);
        background: #f0f6ff;
    }

    .demo-icon {
        font-size: 1.4rem;
        font-weight: 700;
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    .demo-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 1px;
    }

    .demo-role {
        font-weight: 700;
        font-size: 0.85rem;
        color: #2c3e50;
    }

    .demo-name {
        font-size: 0.75rem;
        color: #6c757d;
    }

    .demo-email {
        font-size: 0.7rem;
        color: #0d6efd;
        font-family: monospace;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .demo-admin { border-left: 4px solid #6f42c1; }
    .demo-admin .demo-icon { background: #f3efff; color: #6f42c1; }
    .demo-admin .demo-role { color: #6f42c1; }

    .demo-jefe { border-left: 4px solid #fd7e14; }
    .demo-jefe .demo-icon { background: #fff5ed; color: #fd7e14; }
    .demo-jefe .demo-role { color: #fd7e14; }

    .demo-oficina { border-left: 4px solid #0dcaf0; }
    .demo-oficina .demo-icon { background: #edfbff; color: #0ba5c7; }
    .demo-oficina .demo-role { color: #0ba5c7; }

    .demo-rrhh { border-left: 4px solid #20c997; }
    .demo-rrhh .demo-icon { background: #edfff8; color: #198754; }
    .demo-rrhh .demo-role { color: #198754; }

    .demo-operario { border-left: 4px solid #ffc107; }
    .demo-operario .demo-icon { background: #fffced; color: #b58a00; }
    .demo-operario .demo-role { color: #b58a00; }

    .demo-operariot { border-left: 4px solid #6c757d; }
    .demo-operariot .demo-icon { background: #f5f5f5; color: #6c757d; }
    .demo-operariot .demo-role { color: #6c757d; }

    @@media (max-width: 900px) {
        .login-wrapper {
            flex-direction: column;
        }

        .login-form-panel {
            flex: unset;
        }

        .demo-users-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = default!;

    private string? errorMessage;
    private bool isLoading;
    private bool mostrarAyudaDemo;

    protected override void OnInitialized()
    {
        loginModel ??= new();
        mostrarAyudaDemo = Configuration.GetValue<bool>("FeatureFlags:EnableDemoLoginHints");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await SignInManager.PasswordSignInAsync(
                loginModel.Email,
                loginModel.Password,
                loginModel.RememberMe,
                lockoutOnFailure: false
            );

            if (result.Succeeded)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result.IsLockedOut)
            {
                errorMessage = "Tu cuenta esta bloqueada. Contacta al administrador.";
            }
            else if (result.IsNotAllowed)
            {
                errorMessage = "Debes confirmar tu correo electronico antes de iniciar sesion.";
            }
            else
            {
                errorMessage = "Correo o contrasena incorrectos.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesion: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El correo electronico es obligatorio")]
        [EmailAddress(ErrorMessage = "El formato del correo no es valido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contrasena es obligatoria")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
