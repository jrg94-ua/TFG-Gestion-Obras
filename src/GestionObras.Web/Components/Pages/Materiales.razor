@page "/materiales"
@using GestionObras.Core.Contracts.Materiales
@using Microsoft.AspNetCore.Authorization
@using GestionObras.Web.Services
@inject MaterialesApiClient MaterialesApi
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Materiales - Gestión Obras</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-box-seam"></i> Gestión de Materiales
        </h1>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/admin/catalogos")'>
                <i class="bi bi-gear"></i> Catálogos
            </button>
            <button class="btn btn-primary" @onclick="AbrirModalNuevo">
                <i class="bi bi-plus-circle"></i> Nuevo Material
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" placeholder="🔍 Buscar material..."
                           @bind="filtroNombre" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="filtroCategoria">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in categoriasDisponibles)
                        {
                            <option value="@categoria">@categoria</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de materiales -->
    <div class="card">
        <div class="card-body">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando materiales...</p>
                </div>
            }
            else if (!materialesFiltrados.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i> No se encontraron materiales
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Estado</th>
                                <th>Stock</th>
                                <th>Unidad</th>
                                <th>Precio</th>
                                <th>Proveedor</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in materialesFiltrados)
                            {
                                <tr>
                                    <td><code>@material.Codigo</code></td>
                                    <td><strong>@material.Nombre</strong></td>
                                    <td>
                                        <span class="badge bg-secondary">@material.Categoria</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(material.Activo ? "success" : "secondary")">
                                            @(material.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td>
                                        @if (material.StockDisponible <= material.StockMinimo)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-triangle"></i> @material.StockDisponible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@material.StockDisponible</span>
                                        }
                                    </td>
                                    <td>@material.UnidadMedida</td>
                                    <td>@material.PrecioUnitario.ToString("C2")</td>
                                    <td>
                                        @if (material.Proveedores.Any())
                                        {
                                            <span class="text-muted">@string.Join(", ", material.Proveedores.Select(p => p.Nombre))</span>
                                        }
                                        else if (material.Proveedor != null)
                                        {
                                            <span class="text-muted">@material.Proveedor.Nombre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin proveedor</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    @onclick="() => AbrirModalEditar(material)"
                                                    title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" 
                                                    @onclick="() => ConfirmarEliminar(material)"
                                                    title="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para crear/editar material -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(materialSeleccionado.Id == 0 ? "Nuevo Material" : "Editar Material")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Código *</label>
                            <input class="form-control" @bind="materialSeleccionado.Codigo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <input class="form-control" @bind="materialSeleccionado.Nombre" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" rows="2" @bind="materialSeleccionado.Descripcion"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría *</label>
                            <select class="form-select" @bind="materialSeleccionado.Categoria">
                                <option value="">Seleccione...</option>
                                @foreach (var categoria in categoriasDisponibles)
                                {
                                    <option value="@categoria">@categoria</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Unidad de Medida *</label>
                            <input class="form-control" @bind="materialSeleccionado.UnidadMedida" placeholder="m², kg, unid..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Precio Unitario *</label>
                            <input type="number" step="0.01" class="form-control" @bind="materialSeleccionado.PrecioUnitario" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Stock Disponible *</label>
                            <input type="number" step="0.01" class="form-control" @bind="materialSeleccionado.StockDisponible" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Stock Mínimo *</label>
                            <input type="number" step="0.01" class="form-control" @bind="materialSeleccionado.StockMinimo" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Proveedores</label>
                            <div class="row g-2">
                                @foreach (var proveedor in proveedoresDisponibles)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="prov-@proveedor.Id" checked="@(proveedoresSeleccionados.Contains(proveedor.Id))" @onchange="e => AlternarProveedorSeleccion(proveedor.Id, e)" />
                                            <label class="form-check-label" for="prov-@proveedor.Id">
                                                @proveedor.Nombre
                                                <span class="badge bg-@(proveedor.Activo ? "success" : "secondary") ms-1">@(proveedor.Activo ? "Activo" : "Inactivo")</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarMaterial">
                        <i class="bi bi-save2"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de confirmación de eliminación -->
@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que desea eliminar el material?</p>
                    <p class="fw-bold">@materialAEliminar?.Nombre</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarMaterial">
                        <i class="bi bi-trash3-fill"></i> Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialResumenDto> materiales = new();
    private List<ProveedorResumenDto> proveedoresDisponibles = new();
    private HashSet<int> proveedoresSeleccionados = new();
    private List<string> categoriasDisponibles = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private MaterialFormModel materialSeleccionado = new();
    private MaterialResumenDto? materialAEliminar;

    private string filtroNombre = "";
    private string filtroCategoria = "";

    private IEnumerable<MaterialResumenDto> materialesFiltrados => materiales
        .Where(m => string.IsNullOrEmpty(filtroNombre) || 
                   m.Nombre.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase) ||
                   m.Codigo.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase))
        .Where(m => string.IsNullOrEmpty(filtroCategoria) || m.Categoria == filtroCategoria);

    protected override async Task OnInitializedAsync()
    {
        await CargarMateriales();
    }

    private async Task CargarMateriales()
    {
        cargando = true;
        try
        {
            var response = await MaterialesApi.ObtenerMaterialesGestionAsync();
            materiales = response.Materiales;
            proveedoresDisponibles = response.Proveedores;
            categoriasDisponibles = response.Categorias.Select(c => c.Nombre).ToList();

            if (!categoriasDisponibles.Any())
            {
                categoriasDisponibles = materiales
                    .Select(m => m.Categoria)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(c => c)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar materiales: {ex.Message}");
            materiales = new List<MaterialResumenDto>();
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        materialSeleccionado = new MaterialFormModel
        { 
            StockDisponible = 0,
            StockMinimo = 100,
            Activo = true
        };
        proveedoresSeleccionados = new HashSet<int>();
        mostrarModal = true;
        StateHasChanged();
    }

    private void AbrirModalEditar(MaterialResumenDto material)
    {
        materialSeleccionado = new MaterialFormModel
        {
            Id = material.Id,
            Codigo = material.Codigo,
            Nombre = material.Nombre,
            Descripcion = material.Descripcion,
            Categoria = material.Categoria,
            UnidadMedida = material.UnidadMedida,
            PrecioUnitario = material.PrecioUnitario,
            StockDisponible = material.StockDisponible,
            StockMinimo = material.StockMinimo,
            ProveedorId = material.ProveedorId,
            Activo = material.Activo
        };
        proveedoresSeleccionados = material.Proveedores.Select(p => p.Id).ToHashSet();
        if (materialSeleccionado.ProveedorId.HasValue)
        {
            proveedoresSeleccionados.Add(materialSeleccionado.ProveedorId.Value);
        }
        mostrarModal = true;
        StateHasChanged();
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        materialSeleccionado = new();
    }

    private async Task GuardarMaterial()
    {
        try
        {
            materialSeleccionado.ProveedorId = proveedoresDisponibles
                .FirstOrDefault(p => proveedoresSeleccionados.Contains(p.Id))?.Id;
            var resultado = await MaterialesApi.GuardarMaterialAsync(new GuardarMaterialRequest
            {
                Id = materialSeleccionado.Id,
                Codigo = materialSeleccionado.Codigo,
                Nombre = materialSeleccionado.Nombre,
                Descripcion = materialSeleccionado.Descripcion,
                Activo = materialSeleccionado.Activo,
                PrecioUnitario = materialSeleccionado.PrecioUnitario,
                UnidadMedida = materialSeleccionado.UnidadMedida,
                StockDisponible = materialSeleccionado.StockDisponible,
                StockMinimo = materialSeleccionado.StockMinimo,
                Categoria = materialSeleccionado.Categoria,
                ProveedorIds = proveedoresSeleccionados.ToList()
            });

            if (!resultado.Correcto)
            {
                Console.WriteLine(resultado.Mensaje);
                return;
            }

            await CargarMateriales();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar material: {ex.Message}");
        }
        
        CerrarModal();
        StateHasChanged();
    }

    private void ConfirmarEliminar(MaterialResumenDto material)
    {
        materialAEliminar = material;
        mostrarModalEliminar = true;
        StateHasChanged();
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        materialAEliminar = null;
    }

    private async Task EliminarMaterial()
    {
        if (materialAEliminar != null)
        {
            try
            {
                var resultado = await MaterialesApi.EliminarMaterialAsync(materialAEliminar.Id);
                if (!resultado.Correcto)
                {
                    Console.WriteLine(resultado.Mensaje);
                    return;
                }
                await CargarMateriales();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al eliminar material: {ex.Message}");
            }
        }
        CerrarModalEliminar();
        StateHasChanged();
    }

    private void LimpiarFiltros()
    {
        filtroNombre = "";
        filtroCategoria = "";
    }

    private void AlternarProveedorSeleccion(int proveedorId, ChangeEventArgs e)
    {
        var seleccionado = bool.TryParse(e.Value?.ToString(), out var valor) && valor;

        if (seleccionado)
        {
            proveedoresSeleccionados.Add(proveedorId);
        }
        else
        {
            proveedoresSeleccionados.Remove(proveedorId);
        }
    }

    private sealed class MaterialFormModel
    {
        public int Id { get; set; }
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string Categoria { get; set; } = string.Empty;
        public string UnidadMedida { get; set; } = string.Empty;
        public decimal PrecioUnitario { get; set; }
        public int StockDisponible { get; set; }
        public decimal StockMinimo { get; set; }
        public int? ProveedorId { get; set; }
        public bool Activo { get; set; } = true;
    }
}
