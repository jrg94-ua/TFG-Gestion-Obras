@page "/jefe-obra/control-fichajes"
@attribute [Authorize(Roles = "JefeObra,OficinaTecnica,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using GestionObras.Core.Contracts.JefeObra
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject JefeObraApiClient JefeObraApiClient
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Fichajes de mi equipo - Gestion de Obras</PageTitle>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary">Fichajes de mi equipo</h1>
                <p class="text-muted mb-0">Consulta la asistencia de los operarios en tus proyectos</p>
            </div>
            <span class="badge bg-info fs-6">Solo lectura - La validacion se realiza desde RRHH</span>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-success shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-success">@fichajes.Count(f => f.HoraSalida == null)</h3>
                        <p class="mb-0">En jornada ahora</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-primary shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-primary">@fichajes.Count(f => f.HoraSalida != null)</h3>
                        <p class="mb-0">Jornadas completadas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-warning">@fichajes.Count(f => f.Estado == EstadoFichaje.Pendiente)</h3>
                        <p class="mb-0">Pendientes</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-info">@(fichajes.Where(f => f.TotalHoras.HasValue).Sum(f => f.TotalHoras!.Value).ToString("F1")) h</h3>
                        <p class="mb-0">Horas totales</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Proyecto</label>
                        <select class="form-select" @bind="filtroProyectoId" @bind:after="CargarFichajes">
                            <option value="">Todos mis proyectos</option>
                            @foreach (var proyecto in misProyectos)
                            {
                                <option value="@proyecto.Id">@proyecto.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Desde</label>
                        <input type="date" class="form-control" @bind="fechaDesde" @bind:after="CargarFichajes" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Hasta</label>
                        <input type="date" class="form-control" @bind="fechaHasta" @bind:after="CargarFichajes" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="filtroEstado" @bind:after="AplicarFiltroEstado">
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Validado">Validado</option>
                            <option value="Rechazado">Rechazado</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (!fichajesFiltrados.Any())
                {
                    <p class="text-center text-muted p-4">No hay fichajes en el rango seleccionado.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Operario</th>
                                    <th>Fecha</th>
                                    <th>Entrada</th>
                                    <th>Salida</th>
                                    <th>Proyecto</th>
                                    <th>Horas</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fichaje in fichajesFiltrados)
                                {
                                    <tr class="@(fichaje.HoraSalida == null ? "table-success" : "")">
                                        <td><strong>@fichaje.UsuarioNombreCompleto</strong></td>
                                        <td>@fichaje.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@fichaje.HoraEntrada.ToString("HH:mm")</td>
                                        <td>@(fichaje.HoraSalida?.ToString("HH:mm") ?? "En curso")</td>
                                        <td>@(fichaje.ProyectoNombre ?? "-")</td>
                                        <td>@(fichaje.TotalHoras.HasValue ? $"{fichaje.TotalHoras:F1} h" : "-")</td>
                                        <td>
                                            @switch (fichaje.Estado)
                                            {
                                                case EstadoFichaje.Pendiente:
                                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                                    break;
                                                case EstadoFichaje.Validado:
                                                    <span class="badge bg-success">Validado</span>
                                                    break;
                                                case EstadoFichaje.Rechazado:
                                                    <span class="badge bg-danger">Rechazado</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private string? usuarioActualId;
    private List<ProyectoResumenDto> misProyectos = new();
    private List<RegistroFichajeDto> fichajes = new();
    private List<RegistroFichajeDto> fichajesFiltrados = new();

    private string filtroProyectoId = string.Empty;
    private DateTime fechaDesde = DateTime.Today.AddDays(-7);
    private DateTime fechaHasta = DateTime.Today;
    private string filtroEstado = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioActualId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(usuarioActualId))
        {
            await CargarFichajes();
        }

        cargando = false;
    }

    private async Task CargarFichajes()
    {
        if (string.IsNullOrWhiteSpace(usuarioActualId))
        {
            misProyectos = new();
            fichajes = new();
            fichajesFiltrados = new();
            return;
        }

        var desde = DateOnly.FromDateTime(fechaDesde);
        var hasta = DateOnly.FromDateTime(fechaHasta);
        int? proyectoId = int.TryParse(filtroProyectoId, out var pid) ? pid : null;

        var respuesta = await JefeObraApiClient.ObtenerFichajesAsync(desde, hasta, proyectoId);
        misProyectos = respuesta.Proyectos;
        fichajes = respuesta.Fichajes;
        AplicarFiltroEstado();
    }

    private void AplicarFiltroEstado()
    {
        fichajesFiltrados = string.IsNullOrWhiteSpace(filtroEstado)
            ? fichajes
            : fichajes.Where(f => f.Estado.ToString() == filtroEstado).ToList();
    }
}
