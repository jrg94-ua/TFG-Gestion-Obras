@page "/jefe-obra/horarios"
@attribute [Authorize(Roles = "JefeObra,OficinaTecnica,Administrador")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using GestionObras.Core.Contracts.JefeObra
@using GestionObras.Core.Entities
@using GestionObras.Web.Services
@inject JefeObraApiClient JefeObraApiClient
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Horarios de mi equipo - Gestion de Obras</PageTitle>

<style>
    .cal-grid {
        display: grid;
        grid-template-columns: 220px repeat(7, 1fr);
        gap: 1px;
        background: #dee2e6;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .cal-hdr {
        background: #2c3e50;
        color: white;
        padding: 14px 8px;
        font-weight: 600;
        text-align: center;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cal-hdr.corner { background: #1a252f; }
    .cal-hdr.hoy { background: #1b5e20; }
    .cal-name {
        background: #f8f9fa;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-right: 3px solid #2c3e50;
        min-height: 76px;
    }
    .cal-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white; display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 700; flex-shrink: 0;
    }
    .cal-name-info { display: flex; flex-direction: column; }
    .cal-name-info strong { font-size: 0.85rem; color: #2c3e50; }
    .cal-name-info small { font-size: 0.72rem; color: #6c757d; }
    .cal-cell {
        background: white; padding: 5px; min-height: 76px;
        display: flex; flex-direction: column; gap: 3px;
    }
    .cal-cell.hoy-col { background: #e8f5e9; }
    .turno-pill {
        border-radius: 8px; padding: 4px 8px; font-size: 0.72rem;
        font-weight: 600; display: flex; align-items: center; gap: 4px;
        line-height: 1.3;
    }
    .t-man { background: #fff3cd; color: #856404; border-left: 3px solid #ffc107; }
    .t-tar { background: #cfe2ff; color: #084298; border-left: 3px solid #0d6efd; }
    .t-noc { background: #d3d3d9; color: #1e1e2f; border-left: 3px solid #343a40; }
    .t-par { background: #e2d9f3; color: #432874; border-left: 3px solid #6f42c1; }
    .legend-bar { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
    .legend-dot { width: 14px; height: 14px; border-radius: 4px; }
    .legend-item { display: flex; align-items: center; gap: 5px; font-size: 0.82rem; }
</style>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary">Horarios de mi equipo</h1>
                <p class="text-muted mb-0">Consulta los turnos semanales de los operarios en tus proyectos</p>
            </div>
            <span class="badge bg-info fs-6">Solo lectura</span>
        </div>

        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Proyecto</label>
                        <select class="form-select" @bind="filtroProyectoId" @bind:after="CargarHorarios">
                            <option value="">Todos mis proyectos</option>
                            @foreach (var proyecto in misProyectos)
                            {
                                <option value="@proyecto.Id">@proyecto.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Operario</label>
                        <select class="form-select" @bind="filtroUsuarioId" @bind:after="CargarHorarios">
                            <option value="">Todos</option>
                            @foreach (var operario in operariosDisponibles)
                            {
                                <option value="@operario.Id">@operario.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="legend-bar ms-auto">
                            <div class="legend-item"><div class="legend-dot" style="background:#ffc107;"></div> Manana</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#0d6efd;"></div> Tarde</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#343a40;"></div> Noche</div>
                            <div class="legend-item"><div class="legend-dot" style="background:#6f42c1;"></div> Partido</div>
                            <span class="badge bg-secondary ms-2">@horarios.Count turnos · @trabConHorario.Count personas</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!trabConHorario.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-5">
                    <div class="display-1 mb-3">Horarios</div>
                    <h4 class="text-muted">No hay horarios asignados para tu equipo</h4>
                    <p class="text-muted">Contacta con RRHH para configurar los turnos</p>
                </div>
            </div>
        }
        else
        {
            <div class="cal-grid">
                <div class="cal-hdr corner">Operario</div>
                @foreach (DiaSemana dia in Enum.GetValues<DiaSemana>())
                {
                    <div class="cal-hdr @(EsHoy(dia) ? "hoy" : "")">
                        @DiaCorto(dia)
                        @if (EsHoy(dia))
                        {
                            <br /><span style="font-weight:400;opacity:0.8;font-size:0.7rem;">HOY</span>
                        }
                    </div>
                }

                @foreach (var operario in trabConHorario)
                {
                    var horasSemana = HorasSemana(operario.Id);
                    <div class="cal-name">
                        <div class="cal-avatar">@Iniciales(operario.NombreCompleto)</div>
                        <div class="cal-name-info">
                            <strong>@operario.NombreCompleto</strong>
                            <small>@horasSemana.ToString("F0") h / semana</small>
                        </div>
                    </div>

                    @foreach (DiaSemana dia in Enum.GetValues<DiaSemana>())
                    {
                        var turnos = TurnosDia(operario.Id, dia);
                        <div class="cal-cell @(EsHoy(dia) ? "hoy-col" : "")">
                            @foreach (var horario in turnos)
                            {
                                <div class="turno-pill @TurnoClass(horario.TipoTurno)">
                                    @TurnoIcon(horario.TipoTurno) @horario.HoraEntrada.ToString("HH:mm")-@horario.HoraSalida.ToString("HH:mm")
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (horarios.Any(h => !string.IsNullOrWhiteSpace(h.ProyectoNombre)))
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white fw-semibold">Resumen por proyecto</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Proyecto</th><th>Trabajadores</th><th>Turnos</th><th>Horas/sem</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var grupo in horarios.Where(h => !string.IsNullOrWhiteSpace(h.ProyectoNombre)).GroupBy(h => h.ProyectoNombre!))
                                {
                                    <tr>
                                        <td><strong>@grupo.Key</strong></td>
                                        <td>@grupo.Select(h => h.UsuarioId).Distinct().Count()</td>
                                        <td>@grupo.Count()</td>
                                        <td>@grupo.Sum(h => h.HorasPrevistas).ToString("F0") h</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private bool cargando = true;
    private string? usuarioActualId;
    private List<ProyectoResumenDto> misProyectos = new();
    private List<UsuarioResumenDto> operariosDisponibles = new();
    private List<HorarioAsignadoDto> horarios = new();
    private List<UsuarioResumenDto> trabConHorario = new();

    private string filtroProyectoId = string.Empty;
    private string filtroUsuarioId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioActualId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(usuarioActualId))
        {
            await CargarHorarios();
        }

        cargando = false;
    }

    private async Task CargarHorarios()
    {
        if (string.IsNullOrWhiteSpace(usuarioActualId))
        {
            misProyectos = new();
            operariosDisponibles = new();
            horarios = new();
            trabConHorario = new();
            return;
        }

        int? proyectoId = int.TryParse(filtroProyectoId, out var pid) ? pid : null;
        var respuesta = await JefeObraApiClient.ObtenerHorariosAsync(proyectoId, filtroUsuarioId);
        misProyectos = respuesta.Proyectos;
        operariosDisponibles = respuesta.Operarios;
        horarios = respuesta.Horarios;

        var ids = horarios.Select(h => h.UsuarioId).Distinct().ToHashSet();
        trabConHorario = operariosDisponibles.Where(o => ids.Contains(o.Id)).ToList();
    }

    private List<HorarioAsignadoDto> TurnosDia(string usuarioId, DiaSemana dia) =>
        horarios.Where(h => h.UsuarioId == usuarioId && h.DiaSemana == dia).ToList();

    private double HorasSemana(string usuarioId) =>
        horarios.Where(h => h.UsuarioId == usuarioId).Sum(h => h.HorasPrevistas);

    private bool EsHoy(DiaSemana dia) => dia == (DateTime.Now.DayOfWeek switch
    {
        DayOfWeek.Monday => DiaSemana.Lunes,
        DayOfWeek.Tuesday => DiaSemana.Martes,
        DayOfWeek.Wednesday => DiaSemana.Miercoles,
        DayOfWeek.Thursday => DiaSemana.Jueves,
        DayOfWeek.Friday => DiaSemana.Viernes,
        DayOfWeek.Saturday => DiaSemana.Sabado,
        DayOfWeek.Sunday => DiaSemana.Domingo,
        _ => DiaSemana.Lunes
    });

    private static string DiaCorto(DiaSemana dia) => dia switch
    {
        DiaSemana.Lunes => "LUN",
        DiaSemana.Martes => "MAR",
        DiaSemana.Miercoles => "MIE",
        DiaSemana.Jueves => "JUE",
        DiaSemana.Viernes => "VIE",
        DiaSemana.Sabado => "SAB",
        DiaSemana.Domingo => "DOM",
        _ => dia.ToString()
    };

    private static string TurnoClass(TipoTurno turno) => turno switch
    {
        TipoTurno.Mañana => "t-man",
        TipoTurno.Tarde => "t-tar",
        TipoTurno.Noche => "t-noc",
        TipoTurno.Partido => "t-par",
        _ => string.Empty
    };

    private static string TurnoIcon(TipoTurno turno) => turno switch
    {
        TipoTurno.Mañana => "M",
        TipoTurno.Tarde => "T",
        TipoTurno.Noche => "N",
        TipoTurno.Partido => "P",
        _ => string.Empty
    };

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2
            ? $"{partes[0][0]}{partes[1][0]}"
            : (partes.Length > 0 ? partes[0][0].ToString() : "?");
    }
}
